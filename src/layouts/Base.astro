---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;

import '../styles/site.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { DISCLOSURE, hasTag } from '../lib/affiliate';
import { isNoIndexPath } from '../lib/seo';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(canonicalPath, Astro.site);

const bannerText = hasTag
  ? DISCLOSURE
  : 'Rastreador de precios y ofertas en Amazon.es. Enlaces de compra directa con atribución legal. Más info en ' +
    u('aviso-afiliados/');

const nav: Array<[string, string]> = [
  ['Inicio', u('')],
  ['Chollos', u('') + '#chollos'],
  ['Tops', u('') + '#tops'],
  ['Historial', u('registro/')],
  ['Buscador', u('') + '#buscador'],
];

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const isCurrent = (href: string) => {
  const normHref = href.endsWith('/') ? href : href + '/';
  return currentPath === normHref;
};
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {isNoIndexPath(Astro.url.pathname) && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orza" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(u('apple-touch-icon.png'), Astro.site).toString()} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f8fafc" id="meta-theme-color" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var t = 'light';
        try {
          var saved = localStorage.getItem('adc-theme');
          if (saved === 'dark' || saved === 'light') t = saved;
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
        var meta = document.getElementById('meta-theme-color');
        if (meta) meta.setAttribute('content', t === 'dark' ? '#0b0f17' : '#f8fafc');
      })();
    </script>
  </head>
  <body>
    <header>
      <div class="wrap header-inner">
        <div class="header-bar">
          <a class="brand-link" href={u('')} aria-label="Orza — Inicio">
            <Logo size="md" />
          </a>
          <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Cambiar entre tema claro y oscuro" aria-pressed="false">
            <span class="theme-toggle-icon" aria-hidden="true">
              <Icon name="sun" size={15} class="icon-sun" />
              <Icon name="moon" size={15} class="icon-moon" />
            </span>
            <span id="theme-label" class="theme-toggle-label">Oscuro</span>
          </button>
        </div>
        <nav aria-label="Navegación principal">
          {nav.map(([label, href]) => (
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <div class="banner">{bannerText}</div>

    <main class="wrap">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <Logo size="md" />
            <p class="fine" style="margin-top: 0.85rem;">
              Plataforma de inteligencia y seguimiento de precios en Amazon.es. Diseñada para comprar con criterio técnico y al menor coste registrado.
            </p>
          </div>
          <div class="footer-col">
            <span class="footer-heading">Categorías</span>
            <ul class="footer-links">
              <li><a href={u('') + '#chollos'}>Chollos & Descuentos</a></li>
              <li><a href={u('registro/')}>Registro Histórico</a></li>
              <li><a href={u('') + '#tops'}>Tops por Categoría</a></li>
              <li><a href={u('') + '#buscador'}>Buscador Amazon</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <span class="footer-heading">Transparencia</span>
            <ul class="footer-links">
              <li><a href={u('aviso-afiliados/')}>Aviso de Afiliados</a></li>
              <li><a href={u('privacidad/')}>Privacidad</a></li>
              <li><a href={u('cookies/')}>Cookies</a></li>
              <li><a href={u('sobre/')}>Sobre Orza</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p class="fine">
            <strong>Aviso de Afiliación:</strong> {DISCLOSURE}
            Amazon y el logotipo de Amazon son marcas comerciales de Amazon.com, Inc. o sus filiales. Este sitio web no está gestionado por Amazon ni es una tienda directa.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      const labelEl = document.getElementById('theme-label');
      const meta = document.getElementById('meta-theme-color');

      function syncBtn() {
        if (!btn) return;
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (labelEl) labelEl.textContent = isDark ? 'Claro' : 'Oscuro';
        btn.setAttribute('aria-pressed', String(isDark));
        btn.setAttribute('aria-label', isDark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
      }

      btn?.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme');
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('adc-theme', next);
        } catch (e) {}
        if (meta) meta.setAttribute('content', next === 'dark' ? '#0b0f17' : '#f8fafc');
        syncBtn();
      });

      syncBtn();
    </script>
  </body>
</html>
