---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;

import '../styles/site.css';
import { DISCLOSURE, hasTag } from '../lib/affiliate';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(canonicalPath, Astro.site);

const bannerText = hasTag
  ? DISCLOSURE
  : 'Rastreador de precios y ofertas en Amazon.es. Enlaces de compra directa con atribución legal. Más info en ' +
    u('aviso-afiliados/');

const nav: Array<[string, string]> = [
  ['Tracker', u('')],
  ['🔥 Chollos', u('') + '#chollos'],
  ['⭐ Tops', u('') + '#tops'],
  ['📊 Histórico', u('registro/')],
  ['🎯 Buscador', u('') + '#buscador'],
];

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const isCurrent = (href: string) => {
  const normHref = href.endsWith('/') ? href : href + '/';
  return currentPath === normHref;
};
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f8fafc" id="meta-theme-color" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var t = 'light';
        try {
          var saved = localStorage.getItem('adc-theme');
          if (saved === 'dark' || saved === 'light') t = saved;
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
        var meta = document.getElementById('meta-theme-color');
        if (meta) meta.setAttribute('content', t === 'dark' ? '#0b0f17' : '#f8fafc');
      })();
    </script>
  </head>
  <body>
    <header>
      <div class="wrap header-inner">
        <div class="header-bar">
          <a class="brand-link" href={u('')} aria-label="Orza — Inicio">
            <span class="logo">ORZA</span>
            <span class="logo-tag">PRICE TRACKER</span>
          </a>
          <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Cambiar entre tema claro y oscuro" aria-pressed="false">
            <span class="theme-toggle-icon" aria-hidden="true">
              <svg class="icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"></circle>
                <line x1="12" y1="1" x2="12" y2="3"></line>
                <line x1="12" y1="21" x2="12" y2="23"></line>
                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                <line x1="1" y1="12" x2="3" y2="12"></line>
                <line x1="21" y1="12" x2="23" y2="12"></line>
                <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
              </svg>
              <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
              </svg>
            </span>
            <span id="theme-label" class="theme-toggle-label">Oscuro</span>
          </button>
        </div>
        <nav aria-label="Navegación principal">
          {nav.map(([label, href]) => (
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <div class="banner">{bannerText}</div>

    <main class="wrap">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-brand">
            <span class="logo">ORZA</span>
            <p class="fine">
              Rastreador inteligente de precios, mínimos históricos y chollos en Amazon.es. Diseñado para ayudarte a comprar con criterio y al mejor precio registrado.
            </p>
          </div>
          <div class="footer-col">
            <span class="footer-heading">Categorías</span>
            <ul class="footer-links">
              <li><a href={u('') + '#chollos'}>🔥 Chollos & Descuentos</a></li>
              <li><a href={u('registro/')}>📊 Registro Histórico</a></li>
              <li><a href={u('') + '#tops'}>⭐ Tops por Categoría</a></li>
              <li><a href={u('') + '#buscador'}>🎯 Buscador Amazon</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <span class="footer-heading">Transparencia</span>
            <ul class="footer-links">
              <li><a href={u('aviso-afiliados/')}>Aviso de Afiliados</a></li>
              <li><a href={u('privacidad/')}>Privacidad</a></li>
              <li><a href={u('cookies/')}>Cookies</a></li>
              <li><a href={u('sobre/')}>Sobre Orza</a></li>
            </ul>
          </div>
        </div>

        <div class="footer-bottom">
          <p class="fine">
            <strong>Aviso de Afiliación:</strong> {DISCLOSURE}
            Amazon y el logotipo de Amazon son marcas comerciales de Amazon.com, Inc. o sus filiales. Este sitio web no está gestionado por Amazon ni es una tienda directa.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      const labelEl = document.getElementById('theme-label');
      const meta = document.getElementById('meta-theme-color');

      function syncBtn() {
        if (!btn) return;
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        if (labelEl) labelEl.textContent = isDark ? 'Claro' : 'Oscuro';
        btn.setAttribute('aria-pressed', String(isDark));
        btn.setAttribute('aria-label', isDark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
      }

      btn?.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme');
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('adc-theme', next);
        } catch (e) {}
        if (meta) meta.setAttribute('content', next === 'dark' ? '#0b0f17' : '#f8fafc');
        syncBtn();
      });

      syncBtn();
    </script>
  </body>
</html>
