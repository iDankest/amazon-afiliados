---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;

import '../styles/site.css';
import { DISCLOSURE, hasTag } from '../lib/affiliate';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(canonicalPath, Astro.site);

const bannerText = hasTag
  ? DISCLOSURE
  : 'Enlaces a Amazon.es. Aún no hay tag de afiliado configurado: las compras no generan comisión. Aviso legal en ' +
    u('aviso-afiliados/');

const nav: Array<[string, string]> = [
  ['Inicio', u('')],
  ['Descanso', u('') + '#descanso'],
  ['Teclados', u('') + '#teclados'],
  ['Guías', u('guias/')],
  ['Registro', u('registro/')],
  ['Afiliados', u('aviso-afiliados/')],
];

const currentPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const isCurrent = (href: string) => {
  const normHref = href.endsWith('/') ? href : href + '/';
  return currentPath === normHref;
};
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f7f7f5" id="meta-theme-color" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var t = 'light';
        try {
          var saved = localStorage.getItem('adc-theme');
          if (saved === 'dark' || saved === 'light') t = saved;
          else if (window.matchMedia('(prefers-color-scheme: dark)').matches) t = 'dark';
        } catch (e) {}
        document.documentElement.setAttribute('data-theme', t);
        var meta = document.getElementById('meta-theme-color');
        if (meta) meta.setAttribute('content', t === 'dark' ? '#0f141a' : '#f7f7f5');
      })();
    </script>
  </head>
  <body>
    <header>
      <div class="wrap header-inner">
        <a class="logo" href={u('')} aria-label="Orza — inicio">Orza</a>
        <nav aria-label="Principal">
          {nav.map(([label, href]) => (
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          ))}
          <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Cambiar entre tema claro y oscuro" aria-pressed="false">Tema</button>
        </nav>
      </div>
    </header>
    <div class="banner">{bannerText}</div>
    <main class="wrap">
      <slot />
    </main>
    <footer>
      <div class="wrap">
        <p class="fine">
          <strong>Orza.</strong> {DISCLOSURE}
          Amazon y el logotipo de Amazon son marcas de Amazon.com, Inc. o de sus afiliados. Este sitio no es Amazon ni una tienda.
        </p>
        <div class="footer-nav">
          <a href={u('aviso-afiliados/')}>Aviso de afiliados</a>
          <a href={u('privacidad/')}>Privacidad</a>
          <a href={u('cookies/')}>Cookies</a>
          <a href={u('sobre/')}>Sobre</a>
        </div>
      </div>
    </footer>
    <script>
      const btn = document.getElementById('theme-toggle');
      const meta = document.getElementById('meta-theme-color');

      function syncBtn() {
        if (!btn) return;
        const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
        btn.textContent = isDark ? 'Tema · claro' : 'Tema · oscuro';
        btn.setAttribute('aria-pressed', String(isDark));
      }

      btn?.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme');
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('adc-theme', next);
        } catch (e) {}
        if (meta) meta.setAttribute('content', next === 'dark' ? '#0f141a' : '#f7f7f5');
        syncBtn();
      });

      syncBtn();
    </script>
  </body>
</html>
