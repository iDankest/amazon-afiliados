---
interface Props {
  size?: "sm" | "md" | "lg";
  showTagline?: boolean;
}

const { size = "md", showTagline = true } = Astro.props;
const iconSize = size === "sm" ? 24 : size === "lg" ? 36 : 28;
---

<div class={`brand-logo size-${size}`}>
  <svg
    class="brand-icon"
    width={iconSize}
    height={iconSize}
    viewBox="0 0 32 32"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Geometric Badge Contour -->
    <rect x="2" y="2" width="28" height="28" rx="8" class="logo-bg" />
    <!-- Dynamic Direction Apex / Price Vector -->
    <path
      d="M9 13.5L16 20.5L23 13.5"
      stroke="currentColor"
      stroke-width="2.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="logo-vector-main"
    />
    <path
      d="M16 6.5V11"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      class="logo-vector-accent"
    />
    <circle cx="16" cy="24" r="1.5" class="logo-dot" fill="currentColor" />
  </svg>
  <div class="brand-text">
    <span class="brand-name">ORZA</span>
    {showTagline && <span class="brand-tag">OFERTAS & PRECIOS</span>}
  </div>
</div>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    user-select: none;
  }

  .brand-icon {
    flex-shrink: 0;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand-logo:hover .brand-icon {
    transform: translateY(-2px) scale(1.04);
  }

  .logo-bg {
    fill: var(--card-alt);
    stroke: var(--line);
    stroke-width: 1.5;
  }

  .logo-vector-main {
    stroke: var(--accent);
  }

  .logo-vector-accent {
    stroke: var(--amber);
  }

  .logo-dot {
    color: var(--emerald);
  }

  .brand-text {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .brand-name {
    font-family: "Outfit", system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
    color: var(--ink);
    line-height: 1;
  }

  .brand-tag {
    font-family: "Outfit", system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: var(--accent-subtle);
    border: 1px solid var(--banner-line);
    border-radius: 4px;
    padding: 0.15rem 0.45rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .size-sm .brand-name {
    font-size: 1.15rem;
  }

  .size-lg .brand-name {
    font-size: 1.65rem;
  }
</style>
