---
interface Props {
  asin: string;
  title: string;
  size?: 'sm' | 'md' | 'lg' | 'hero';
  class?: string;
}

const { asin, title, size = 'md', class: className = '' } = Astro.props;

// Amazon Direct High-Resolution Media CDN pattern for official product thumbnails
const imageUrl = `https://images-na.ssl-images-amazon.com/images/P/${asin}.01._SCLZZZZZZZ_SX500_.jpg`;
---

<div class={`product-img-wrap size-${size} ${className}`}>
  <img
    src={imageUrl}
    alt={`Foto oficial de ${title}`}
    loading="lazy"
    decoding="async"
    class="product-img-el"
    onerror="this.style.opacity='0.4'; this.classList.add('img-fallback');"
  />
</div>

<style>
  .product-img-wrap {
    background: var(--card-alt);
    border: 1px solid var(--line);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    transition: transform 0.2s ease;
  }

  .product-img-wrap.size-sm {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .product-img-wrap.size-md {
    width: 100%;
    height: 180px;
    margin-bottom: 1rem;
    padding: 0.75rem;
  }

  .product-img-wrap.size-lg {
    width: 100%;
    height: 240px;
    margin-bottom: 1.25rem;
    padding: 1rem;
  }

  .product-img-wrap.size-hero {
    width: 100%;
    max-width: 380px;
    height: 320px;
    padding: 1.5rem;
    border-radius: 16px;
  }

  .product-img-el {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  html[data-theme="dark"] .product-img-el {
    mix-blend-mode: normal;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.35));
  }

  .product-img-wrap:hover .product-img-el {
    transform: scale(1.04);
  }
</style>
