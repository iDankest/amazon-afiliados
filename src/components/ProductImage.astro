---
import { SIZE_PX, imageUrlFor, fallbackChain, FALLBACK_PX } from '../lib/productImages';
import type { ImageSize } from '../lib/productImages';

interface Props {
  /** Producto del catálogo (porta `asin` y `images?`). */
  product: { asin?: string; images?: string[] };
  title: string;
  size?: ImageSize;
  class?: string;
}

const { product, title, size = 'md', class: className = '' } = Astro.props;

// Single source of truth (src/lib/productImages.ts): m.media-amazon.com +
// variante _SX{n}_ por tamaño; imágenes reales del catálogo tienen prioridad.
const src = imageUrlFor(product, size);
const chain = fallbackChain(product, size);
const fallbackPx = Math.max(SIZE_PX[size], FALLBACK_PX);
const initials = title
  .split(/\s+/)
  .filter((w) => /[0-9A-ZÁÉÍÓÚÑ]/i.test(w))
  .map((w) => [...w][0])
  .filter((c) => /[0-9A-ZÁÉÍÓÚÑ]/i.test(c))
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<div class={`product-img-wrap size-${size} ${className}`}>
  {
    src ? (
      <img
        src={src}
        alt={`Foto oficial de ${title}`}
        loading="lazy"
        decoding="async"
        class="product-img-el"
        data-fallback={JSON.stringify(chain.slice(1))}
        onload="if(this.naturalWidth<=1)this.onerror()"
        onerror={`var n=(this.dataset.fb=this.dataset.fb?JSON.parse(this.dataset.fb):[]),u=n.shift();if(u){this.dataset.fb=JSON.stringify(n);this.src=u}else{this.style.display='none';this.parentElement.classList.add('no-image')}`}
      />
    ) : (
      <div class="product-img-el no-image" aria-hidden="true"></div>
    )
  }
  {
    /* Placeholder explícito: se muestra cuando no hay URL legítima o la cadena de
       fallback (pedida → SX500) se agota. Colores propios para tema claro y oscuro. */
  }
  <svg class="product-img-ph" viewBox="0 0 120 80" role="img" aria-label={`Imagen no disponible para ${title}`}>
    <text x="60" y="42" text-anchor="middle" dominant-baseline="central" class="product-img-ph-initials">
      {initials || '·'}
    </text>
    <text x="60" y="68" text-anchor="middle" class="product-img-ph-label">Imagen no disponible</text>
  </svg>
</div>

<style>
  .product-img-wrap {
    background: var(--card-alt);
    border: 1px solid var(--line);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    transition: transform 0.2s ease;
  }

  .product-img-wrap.size-sm {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    flex-shrink: 0;
  }

  .product-img-wrap.size-md {
    width: 100%;
    height: 180px;
    margin-bottom: 1rem;
    padding: 0.75rem;
  }

  .product-img-wrap.size-lg {
    width: 100%;
    height: 240px;
    margin-bottom: 1.25rem;
    padding: 1rem;
  }

  .product-img-wrap.size-hero {
    width: 100%;
    max-width: 380px;
    height: 320px;
    padding: 1.5rem;
    border-radius: 16px;
  }

  .product-img-el {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  html[data-theme="dark"] .product-img-el {
    mix-blend-mode: normal;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.35));
  }

  .product-img-wrap:hover .product-img-el {
    transform: scale(1.04);
  }

  /* Fallback explícito: iniciales del producto + texto honesto (sin inventar imágenes). */
  .product-img-ph {
    display: none;
    width: 100%;
    height: 100%;
  }

  .product-img-wrap.no-image .product-img-ph,
  .product-img-el.no-image + .product-img-ph {
    display: block;
  }
  .product-img-ph-initials {
    font-family: var(--font-display, inherit);
    font-size: 28px;
    font-weight: 700;
    fill: #6f7787;
  }

  .product-img-ph-label {
    font-family: inherit;
    font-size: 8px;
    font-weight: 500;
    letter-spacing: 0.04em;
    fill: #6f7787;
  }

  .product-img-wrap.size-sm .product-img-ph-label {
    display: none;
  }

  html[data-theme="dark"] .product-img-ph-initials,
  html[data-theme="dark"] .product-img-ph-label {
    fill: #a9b2c4;
  }
</style>
