---
import { SIZE_PX, imageUrlFor, fallbackChain, FALLBACK_PX } from '../lib/productImages';
import type { ImageSize } from '../lib/productImages';

interface Props {
  /** Producto del catálogo (porta `asin` y `images?`). */
  product: { asin?: string; images?: string[] };
  title: string;
  size?: ImageSize;
  class?: string;
}

const { product, title, size = 'md', class: className = '' } = Astro.props;

// Single source of truth (src/lib/productImages.ts): m.media-amazon.com +
// variante _SX{n}_ por tamaño; imágenes reales del catálogo tienen prioridad.
const src = imageUrlFor(product, size);
const chain = fallbackChain(product, size);
const fallbackPx = Math.max(SIZE_PX[size], FALLBACK_PX);
const initials = title
  .split(/\s+/)
  .filter((w) => /[0-9A-ZÁÉÍÓÚÑ]/i.test(w))
  .map((w) => [...w][0])
  .filter((c) => /[0-9A-ZÁÉÍÓÚÑ]/i.test(c))
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

<div class={`product-img-wrap size-${size} ${className}`}>
  {
    src ? (
      <img
        src={src}
        alt={`Foto oficial de ${title}`}
        loading="lazy"
        decoding="async"
        class="product-img-el"
        data-fallback={JSON.stringify(chain.slice(1))}
        onload="if(this.naturalWidth<=1)this.onerror()"
        onerror={`var n=(this.dataset.fb=this.dataset.fb?JSON.parse(this.dataset.fb):[]),u=n.shift();if(u){this.dataset.fb=JSON.stringify(n);this.src=u}else{this.style.display='none';this.parentElement.classList.add('no-image')}`}
      />
    ) : (
      <div class="product-img-el no-image" aria-hidden="true"></div>
    )
  }
  <div class="product-img-ph" aria-label={`Imagen no disponible para ${title}`}>
    <svg class="product-img-ph-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="3" ry="3"></rect>
      <circle cx="8.5" cy="8.5" r="1.5"></circle>
      <polyline points="21 15 16 10 5 21"></polyline>
    </svg>
    <span class="product-img-ph-initials">{initials || '·'}</span>
    <span class="product-img-ph-label">Imagen en catálogo</span>
  </div>
</div>

<style>
  .product-img-wrap {
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    position: relative;
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.02);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;
  }

  html[data-theme="dark"] .product-img-wrap {
    background: #ffffff;
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: var(--shadow-md);
  }

  .product-img-wrap.size-sm {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    flex-shrink: 0;
    padding: 0.35rem;
  }

  .product-img-wrap.size-md {
    width: 100%;
    height: 190px;
    margin-bottom: 1rem;
    padding: 1rem;
  }

  .product-img-wrap.size-lg {
    width: 100%;
    height: 250px;
    margin-bottom: 1.25rem;
    padding: 1.25rem;
  }

  .product-img-wrap.size-hero {
    width: 100%;
    max-width: 380px;
    height: 320px;
    padding: 1.75rem;
    border-radius: 14px;
  }
  @media (max-width: 640px) {
    .product-img-wrap.size-hero {
      height: 230px;
      padding: 1.25rem;
    }
  }


  .product-img-el {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.35s ease;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.04));
  }

  html[data-theme="dark"] .product-img-el {
    /* On white studio plate in dark mode, multiply works seamlessly to blend any off-white jpg artifacts */
    mix-blend-mode: multiply;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.08));
  }

  .product-img-wrap:hover .product-img-el {
    transform: scale(1.05) translateY(-2px);
  }

  /* Fallback refinado cuando no hay imagen disponible */
  .product-img-ph {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    color: var(--muted);
    background: var(--card-alt);
  }

  .product-img-wrap.no-image .product-img-ph,
  .product-img-el.no-image + .product-img-ph {
    display: flex;
  }

  .product-img-ph-icon {
    width: 28px;
    height: 28px;
    stroke: var(--muted-light);
    opacity: 0.8;
  }

  .product-img-ph-initials {
    font-family: var(--font-display, inherit);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--muted);
    line-height: 1;
  }

  .product-img-ph-label {
    font-family: var(--font-body, inherit);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .product-img-wrap.size-sm .product-img-ph-label,
  .product-img-wrap.size-sm .product-img-ph-icon {
    display: none;
  }
</style>
