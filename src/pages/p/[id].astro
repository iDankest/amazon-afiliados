---
import Base from '../../layouts/Base.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import Icon from '../../components/Icon.astro';
import ProductImage from '../../components/ProductImage.astro';
import KeepaChart from '../../components/KeepaChart.astro';
import { products, categoryLabel } from '../../lib/catalog';
import { imageUrlFor } from '../../lib/productImages';

export function getStaticPaths() {
  return products.map((p) => ({ params: { id: p.id }, props: { product: p } }));
}

const { product } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');

const canonical = new URL(u(`p/${product.id}/`), Astro.site);
// Single source of truth: src/lib/productImages.ts (sin URL duplicada ni host legado).
// Omite `image` del JSON-LD si la imagen principal es inválida conocida (probe).
// Sin bloque `offers`: Orza no es vendedor del producto (solo enlaza a Amazon.es),
// y Google reserva los `Offer` de merchant listings a quien vende el producto.
const jsonLdImage = imageUrlFor(product, 'hero');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Product',
      name: product.title,
      description: product.notes,
      ...(jsonLdImage ? { image: jsonLdImage } : {}),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL(u(''), Astro.site).toString() },
        { '@type': 'ListItem', position: 2, name: product.title, item: canonical.toString() },
      ],
    },
  ],
};
---

<Base
  title={`${product.title} — Ficha e Histórico en Amazon.es`}
  description={`${product.title}: histórico de precios real de Amazon.es servido por Keepa, criterio de compra y enlace directo de afiliado.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article class="sheet">
    <header class="sheet-head">
      <div class="sheet-head-grid">
        <div style="display: flex; justify-content: center;">
          <ProductImage product={product} title={product.title} size="hero" />
        </div>
        <div>
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem;">
            <span class="category-pill">{categoryLabel[product.category]}</span>
            {product.asin && (
              <span class="stitch-asin-badge" title={`ASIN verificado: ${product.asin}`}>
                <span class="asin-dot" aria-hidden="true"></span>
                <span>ASIN: {product.asin}</span>
              </span>
            )}
          </div>
          <h1 class="sheet-title">{product.title}</h1>
          <p class="sheet-notes">{product.notes}</p>
        </div>
      </div>
    </header>

    <!-- Botón de Compra Directa -->
    <section aria-label="Compra">
      <div style="margin: 1.75rem 0 2.25rem;">
        <AmazonLink
          asin={product.asin}
          query={product.amazonQuery}
          class="btn-buy-amazon"
        >
          <span>Ver Oferta y Comprar en Amazon.es</span>
          <Icon name="arrow-up-right" size={18} />
        </AmazonLink>
        <p style="font-size: 0.78rem; color: var(--muted); margin: 0.5rem 0 0; text-align: center;">
          Enlace con atribución de afiliado a Amazon.es · Sin sobrecostes para ti
        </p>
      </div>
    </section>

    {product.asin && (
      <section style="margin: 2.75rem 0;" aria-label="Histórico de precios">
        <h2>Histórico de Precios en Amazon.es</h2>
        <KeepaChart asin={product.asin} title={product.title} />
      </section>
    )}

    <div style="margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
      <a class="section-link" href={u('')}>← Volver al inicio</a>
      <a class="section-link" href={u('registro/')}>Ver todos los productos seguidos →</a>
    </div>
  </article>
</Base>
