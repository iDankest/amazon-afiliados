---
import Base from '../../layouts/Base.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import {
  products,
  sortedSnapshots,
  priceStats,
  fmtEur,
  fmtDate,
  categoryLabel,
} from '../../lib/catalog';

export function getStaticPaths() {
  return products.map((p) => ({ params: { id: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const snaps = sortedSnapshots(product.id);
const st = priceStats(product.id);
const chartPoints = snaps.map((s) => ({ date: s.date, price: s.price }));
const chartLabels =
  chartPoints.length >= 2
    ? {
        min: fmtEur(st.min!),
        max: fmtEur(st.max!),
        first: fmtDate(snaps[0].date),
        last: fmtDate(snaps[snaps.length - 1].date),
      }
    : null;

const history = snaps.map((s, i) => ({
  no: String(i + 1).padStart(3, '0'),
  s,
  delta: i === 0 ? null : s.price - snaps[i - 1].price,
}));

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');

const deltaLabel = (d: number | null) =>
  d === null ? '—' : (d > 0 ? '+' : d < 0 ? '−' : '±') + fmtEur(Math.abs(d));
---

<Base
  title={`${product.title} — Análisis de Precio e Histórico`}
  description={`${product.title}: evolución histórica de precios, alertas de mínimos y enlace directo de compra en Amazon.es.`}
>
  <article class="sheet">
    <header class="sheet-head">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
        <span class="product-cat">{categoryLabel[product.category]}</span>
        <span class={`deal-badge ${st.lastIsMin ? 'historic' : ''}`}>
          {st.lastIsMin ? 'MÍNIMO HISTÓRICO' : st.statusBadge}
        </span>
      </div>
      <h1 style="margin: 0 0 0.65rem;">{product.title}</h1>
      <p class="sheet-notes">{product.notes}</p>
    </header>

    <!-- Bloque de Métricas y Precio -->
    <section class="sheet-block" aria-label="Análisis de precio actual">
      <h2>Estado Actual del Precio</h2>
      {st.count === 0 ? (
        <div class="empty-state">
          <p class="empty-state-title">A la espera de primeras anotaciones</p>
          <p class="empty-state-text">Este producto está en lista de seguimiento. En cuanto se registre la primera comprobación, aparecerá la gráfica y su rango.</p>
        </div>
      ) : (
        <>
          <div class="sheet-stats" role="group" aria-label="Métricas del precio">
            <div class="sheet-stat">
              <span class="sheet-stat-label">Precio Registrado</span>
              <span class="sheet-stat-value" style="font-size: 1.35rem; color: var(--ink);">
                {fmtEur(st.last!.price)}
              </span>
              <span style="font-size: 0.75rem; color: var(--muted);">{st.lastSeenLabel}</span>
            </div>
            <div class="sheet-stat">
              <span class="sheet-stat-label">Mínimo Histórico</span>
              <span class="sheet-stat-value" style="color: var(--emerald);">
                {fmtEur(st.min!)}
              </span>
              <span style="font-size: 0.75rem; color: var(--muted);">
                {st.lastIsMin ? '¡En mínimo ahora!' : `Máx: ${fmtEur(st.max!)}`}
              </span>
            </div>
            <div class="sheet-stat">
              <span class="sheet-stat-label">Ahorro Estimado</span>
              <span class="sheet-stat-value" style="color: var(--accent);">
                {st.max && st.max > st.last!.price ? fmtEur(st.max - st.last!.price) : '0,00 €'}
              </span>
              <span style="font-size: 0.75rem; color: var(--muted);">
                {st.discountPercent > 0 ? `-${st.discountPercent}% vs máximo` : 'Precio base'}
              </span>
            </div>
          </div>

          <!-- Botón de Compra Directa Primario -->
          <div style="margin: 1.5rem 0;">
            <AmazonLink asin={product.asin} query={product.amazonQuery} class="btn-buy" style="font-size: 1.05rem; padding: 0.85rem 1.6rem; width: 100%;">
              <span>Ver Oferta y Comprar en Amazon.es</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </AmazonLink>
            <p style="font-size: 0.78rem; color: var(--muted); margin: 0.4rem 0 0; text-align: center;">
              Enlace con atribución de afiliado a Amazon.es · Sin coste adicional para ti
            </p>
          </div>
        </>
      )}
    </section>

    {chartPoints.length >= 2 && (
      <section class="sheet-block" aria-label="Gráfica de evolución de precio">
        <h2>Evolución Histórica del Precio</h2>
        <canvas
          id="spark"
          class="spark-canvas"
          role="img"
          aria-label={`Gráfica del precio de ${product.title} entre ${chartLabels!.first} y ${chartLabels!.last}: mínimo ${chartLabels!.min}, máximo ${chartLabels!.max}`}
        ></canvas>
        <p class="sheet-axis" style="display: flex; justify-content: space-between;">
          <span>Desde {chartLabels!.first}</span>
          <span>Hasta {chartLabels!.last}</span>
        </p>
      </section>
    )}

    <section class="sheet-block" aria-label="Historial de comprobaciones">
      <h2>Historial de Registros</h2>
      {history.length === 0 ? (
        <div class="empty-state">
          <p class="empty-state-title">Sin historial todavía</p>
        </div>
      ) : (
        <div class="table-wrap">
          <table class="reg">
            <thead>
              <tr>
                <th scope="col">Nº</th>
                <th scope="col">Fecha</th>
                <th scope="col">Precio</th>
                <th scope="col">Variación</th>
                <th scope="col">Tipo</th>
              </tr>
            </thead>
            <tbody>
              {history.map(({ no, s, delta }) => (
                <tr>
                  <td style="color: var(--muted); font-family: ui-monospace, Menlo, monospace;">{no}</td>
                  <td>{fmtDate(s.date)}</td>
                  <td class="table-price">{fmtEur(s.price)}</td>
                  <td style={delta && delta < 0 ? 'color: var(--emerald); font-weight: 700;' : delta && delta > 0 ? 'color: var(--amber);' : 'color: var(--muted);'}>
                    {deltaLabel(delta)}
                  </td>
                  <td style="color: var(--muted); font-size: 0.8rem;">Verificado</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  </article>

  <p style="margin-top: 2rem;"><a class="section-link" href={u('')}>← Volver al Tracker Principal</a></p>

  <script is:inline define:vars={{ chartPoints, chartLabels }}>
    (function () {
      var canvas = document.getElementById('spark');
      if (!canvas) return;
      function cssVar(name, fallback) {
        var v = getComputedStyle(canvas).getPropertyValue(name).trim();
        return v || fallback;
      }
      function draw() {
        var dpr = window.devicePixelRatio || 1;
        var w = canvas.clientWidth || 600;
        var h = canvas.clientHeight || 160;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        var ctx = canvas.getContext('2d');
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        var line = cssVar('color', '#b45309');
        var muted = cssVar('--muted', '#8493a8');
        var font = '600 10px ui-monospace, "SF Mono", Menlo, monospace';
        var pts = chartPoints;
        var min = Infinity, max = -Infinity;
        for (var i = 0; i < pts.length; i++) {
          if (pts[i].price < min) min = pts[i].price;
          if (pts[i].price > max) max = pts[i].price;
        }
        var flat = max === min;
        var span = flat ? 1 : max - min;
        var pad = 18, padL = 48, padR = 14;
        function x(i) { return pts.length === 1 ? w / 2 : padL + (i * (w - padL - padR)) / (pts.length - 1); }
        function y(v) { return flat ? h / 2 : h - pad - ((v - min) / span) * (h - 2 * pad); }
        ctx.strokeStyle = muted;
        ctx.lineWidth = 1;
        ctx.setLineDash([2, 4]);
        ctx.font = font;
        ctx.fillStyle = muted;
        var levels = flat ? [min] : [min, max];
        for (var li = 0; li < levels.length; li++) {
          var ly = y(levels[li]);
          ctx.beginPath();
          ctx.moveTo(padL - 6, ly);
          ctx.lineTo(w - padR + 6, ly);
          ctx.stroke();
          ctx.textAlign = 'right';
          ctx.textBaseline = 'middle';
          ctx.fillText(flat ? chartLabels.min : levels[li] === min ? chartLabels.min : chartLabels.max, padL - 10, ly);
        }
        ctx.setLineDash([]);
        ctx.strokeStyle = line;
        ctx.lineWidth = 2;
        ctx.lineJoin = 'round';
        ctx.lineCap = 'round';
        ctx.beginPath();
        for (var j = 0; j < pts.length; j++) {
          if (j === 0) ctx.moveTo(x(j), y(pts[j].price));
          else ctx.lineTo(x(j), y(pts[j].price));
        }
        ctx.stroke();
        ctx.fillStyle = line;
        for (var k = 0; k < pts.length; k++) {
          ctx.beginPath();
          ctx.arc(x(k), y(pts[k].price), 3, 0, Math.PI * 2);
          ctx.fill();
        }
        if (isChollo && pts.length > 0) {
          var lx = x(pts.length - 1);
          var ly = y(pts[pts.length - 1].price);
          ctx.beginPath();
          ctx.arc(lx, ly, 6.5, 0, Math.PI * 2);
          ctx.strokeStyle = line;
          ctx.lineWidth = 1.5;
          ctx.stroke();
          ctx.beginPath();
          ctx.arc(lx, ly, 9.5, 0, Math.PI * 2);
          ctx.globalAlpha = 0.45;
          ctx.stroke();
          ctx.globalAlpha = 1;
        }
        ctx.fillStyle = muted;
        ctx.textBaseline = 'alphabetic';
        ctx.font = font;
        ctx.textAlign = 'left';
        ctx.fillText(chartLabels.first, padL, h - 4);
        ctx.textAlign = 'right';
        ctx.fillText(chartLabels.last, w - padR, h - 4);
      }
      draw();
      if (typeof MutationObserver !== 'undefined') {
        new MutationObserver(draw).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['data-theme'],
        });
      }
      var rt;
      window.addEventListener('resize', function () {
        clearTimeout(rt);
        rt = setTimeout(draw, 100);
      });
    })();
  </script>
</Base>

<style>
  .sheet {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow-subtle);
    padding: 1.6rem 1.6rem 1.75rem;
  }

  .sheet-kicker {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: -0.6rem 0 0.4rem;
  }

  .sheet-head h1 {
    margin-bottom: 0.6rem;
  }

  .sheet-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 0.75rem;
  }

  .sheet-notes {
    color: var(--muted);
    margin: 0;
  }

  .sheet-block {
    border-top: 1px solid var(--line-subtle);
    margin-top: 1.6rem;
    padding-top: 1.2rem;
  }

  .sheet-block h2 {
    margin: 0 0 0.75rem;
  }

  .sheet-last {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: clamp(1.9rem, 6vw, 2.6rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    margin: 0 0 0.3rem;
  }

  .sheet-last.is-recent {
    color: var(--ink);
  }

  .sheet-last.is-stale {
    color: var(--muted);
  }

  .sheet-last-date {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0 0 1rem;
  }

  .sheet-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card-alt);
    margin: 0.25rem 0 0;
  }

  .sheet-stat {
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .sheet-stat + .sheet-stat {
    border-left: 1px solid var(--line);
  }

  .sheet-stat-label {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .sheet-stat-value {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 1.05rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .sheet-axis {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin: 0.5rem 0 0;
  }

  .sheet-tablewrap {
    overflow-x: auto;
  }

  table.sheet-lines th {
    border-bottom: 1px solid var(--line);
  }

  table.sheet-lines tbody tr:last-child td {
    border-bottom: 1px solid var(--line-subtle);
  }

  .lines-no {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .lines-delta.is-up {
    color: var(--accent);
  }

  .lines-delta.is-down {
    color: var(--beacon);
  }

  .lines-delta.is-flat {
    color: var(--muted);
  }

  .sheet-note {
    font-size: 0.9rem;
    color: var(--muted);
  }

  @media (max-width: 560px) {
    .sheet {
      padding: 1.25rem 1.1rem 1.4rem;
    }

    .sheet-stats {
      grid-template-columns: 1fr;
    }

    .sheet-stat + .sheet-stat {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
