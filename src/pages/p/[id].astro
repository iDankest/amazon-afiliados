---
import Base from '../../layouts/Base.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import Icon from '../../components/Icon.astro';
import {
  products,
  sortedSnapshots,
  priceStats,
  fmtEur,
  fmtDate,
  categoryLabel,
} from '../../lib/catalog';

export function getStaticPaths() {
  return products.map((p) => ({ params: { id: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const snaps = sortedSnapshots(product.id);
const st = priceStats(product.id);
const chartPoints = snaps.map((s) => ({ date: s.date, price: s.price }));
const chartLabels =
  chartPoints.length >= 2
    ? {
        min: fmtEur(st.min!),
        max: fmtEur(st.max!),
        first: fmtDate(snaps[0].date),
        last: fmtDate(snaps[snaps.length - 1].date),
      }
    : null;

const history = snaps.map((s, i) => ({
  no: String(i + 1).padStart(3, '0'),
  s,
  delta: i === 0 ? null : s.price - snaps[i - 1].price,
}));

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');

const deltaLabel = (d: number | null) =>
  d === null ? '—' : (d > 0 ? '+' : d < 0 ? '−' : '±') + fmtEur(Math.abs(d));
---

<Base
  title={`${product.title} — Análisis de Precio e Histórico en Amazon.es`}
  description={`${product.title}: evolución de precios en Amazon.es, alertas de mínimos comprobados y enlace directo de compra.`}
>
  <article class="sheet">
    <header class="sheet-head">
      <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.85rem;">
        <span class="category-pill">{categoryLabel[product.category]}</span>
        <span class={`discount-tag ${st.lastIsMin ? 'historic' : ''}`}>
          {st.lastIsMin ? '🔥 MÍNIMO HISTÓRICO' : st.statusBadge}
        </span>
      </div>
      <h1 class="sheet-title">{product.title}</h1>
      <p class="sheet-notes">{product.notes}</p>
    </header>

    <!-- Métricas de Cotización -->
    <section aria-label="Métricas de precio">
      <h2>Métricas de Precio</h2>
      {st.count === 0 ? (
        <div style="padding: 1.5rem 0; color: var(--muted);">
          <p>A la espera de primeras anotaciones de precio para este producto.</p>
        </div>
      ) : (
        <>
          <div class="sheet-metrics" role="group" aria-label="Métricas del precio">
            <div class="sheet-metric-card">
              <span class="metric-title">Precio Registrado</span>
              <span class="metric-num" style="color: var(--ink);">
                {fmtEur(st.last!.price)}
              </span>
              <span class="metric-caption">{st.lastSeenLabel}</span>
            </div>
            <div class="sheet-metric-card">
              <span class="metric-title">Mínimo Histórico</span>
              <span class="metric-num" style="color: var(--emerald);">
                {fmtEur(st.min!)}
              </span>
              <span class="metric-caption">
                {st.lastIsMin ? 'En mínimo ahora' : `Pico: ${fmtEur(st.max!)}`}
              </span>
            </div>
            <div class="sheet-metric-card">
              <span class="metric-title">Máximo Visto</span>
              <span class="metric-num" style="color: var(--muted);">
                {st.max ? fmtEur(st.max) : '—'}
              </span>
              <span class="metric-caption">Pico registrado</span>
            </div>
            <div class="sheet-metric-card">
              <span class="metric-title">Ahorro Estimado</span>
              <span class="metric-num" style="color: var(--accent);">
                {st.max && st.max > st.last!.price ? fmtEur(st.max - st.last!.price) : '0,00 €'}
              </span>
              <span class="metric-caption">
                {st.discountPercent > 0 ? `-${st.discountPercent}% vs máximo` : 'Precio base'}
              </span>
            </div>
          </div>

          <!-- Botón de Compra Directa -->
          <div style="margin: 1.75rem 0 2.25rem;">
            <AmazonLink
              asin={product.asin}
              query={product.amazonQuery}
              class="btn-buy-amazon"
              style="font-size: 1.05rem; padding: 0.95rem 1.75rem; width: 100%; border-radius: 10px;"
            >
              <span>Ver Oferta y Comprar en Amazon.es</span>
              <Icon name="arrow-up-right" size={18} />
            </AmazonLink>
            <p style="font-size: 0.78rem; color: var(--muted); margin: 0.5rem 0 0; text-align: center;">
              Enlace con atribución de afiliado a Amazon.es · Sin sobrecostes para ti
            </p>
          </div>
        </>
      )}
    </section>

    {chartPoints.length >= 2 && (
      <section style="margin: 2.75rem 0;" aria-label="Gráfica de evolución">
        <h2>Evolución Histórica de Precios</h2>
        <div class="chart-container">
          <div class="chart-header">
            <span style="font-family: 'Outfit', sans-serif; font-size: 0.82rem; font-weight: 700; color: var(--muted); text-transform: uppercase;">
              Rango: {chartLabels?.min} — {chartLabels?.max}
            </span>
            <span style="font-family: 'Outfit', sans-serif; font-size: 0.82rem; color: var(--muted);">
              {chartLabels?.first} a {chartLabels?.last}
            </span>
          </div>
          <canvas
            id="priceChart"
            class="chart-canvas"
            width="800"
            height="220"
            role="img"
            aria-label={`Evolución del precio de ${product.title}: mínimo ${chartLabels?.min}, máximo ${chartLabels?.max}`}
          ></canvas>
        </div>
      </section>
    )}

    <!-- Historial de Snapshots -->
    <section style="margin-top: 2.75rem;" aria-label="Historial de comprobaciones">
      <h2>Historial de Comprobaciones</h2>
      <div class="table-wrap">
        <table class="reg">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Fecha</th>
              <th scope="col">Precio</th>
              <th scope="col">Variación</th>
              <th scope="col">Estado</th>
            </tr>
          </thead>
          <tbody>
            {history.map(({ no, s, delta }) => (
              <tr>
                <td style="color: var(--muted); font-family: ui-monospace, Menlo, monospace;">{no}</td>
                <td style="font-family: ui-monospace, Menlo, monospace;">{fmtDate(s.date)}</td>
                <td style="font-family: ui-monospace, Menlo, monospace; font-weight: 700;">{fmtEur(s.price)}</td>
                <td style="font-family: ui-monospace, Menlo, monospace; font-weight: 700; color: delta && delta < 0 ? 'var(--emerald)' : delta && delta > 0 ? 'var(--coral)' : 'var(--muted)';">
                  {deltaLabel(delta)}
                </td>
                <td>
                  {s.price === st.min && (
                    <span class="discount-tag historic">MÍNIMO</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div style="margin-top: 2.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;">
      <a class="section-link" href={u('')}>← Volver al inicio</a>
      <a class="section-link" href={u('registro/')}>Ver registro global de precios →</a>
    </div>
  </article>

  {chartPoints.length >= 2 && (
    <script is:inline define:vars={{ chartPoints }}>
      (function () {
        var canvas = document.getElementById('priceChart');
        if (!canvas) return;
        var ctx = canvas.getContext('2d');
        if (!ctx) return;

        function render() {
          var rect = canvas.getBoundingClientRect();
          var dpr = window.devicePixelRatio || 1;
          canvas.width = rect.width * dpr;
          canvas.height = rect.height * dpr;
          ctx.scale(dpr, dpr);

          var W = rect.width;
          var H = rect.height;
          var padL = 60;
          var padR = 20;
          var padT = 20;
          var padB = 30;

          var prices = chartPoints.map(function (p) { return p.price; });
          var minP = Math.min.apply(null, prices);
          var maxP = Math.max.apply(null, prices);
          var range = maxP - minP;
          if (range === 0) range = 1;

          var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          var lineColor = isDark ? '#38bdf8' : '#2563eb';
          var gridColor = isDark ? 'rgba(255,255,255,0.06)' : 'rgba(0,0,0,0.06)';
          var textColor = isDark ? '#94a3b8' : '#71717a';

          ctx.clearRect(0, 0, W, H);

          // Grid lines
          ctx.strokeStyle = gridColor;
          ctx.lineWidth = 1;
          ctx.beginPath();
          for (var i = 0; i <= 3; i++) {
            var y = padT + (H - padT - padB) * (i / 3);
            ctx.moveTo(padL, y);
            ctx.lineTo(W - padR, y);
          }
          ctx.stroke();

          // Price points
          var coords = chartPoints.map(function (p, idx) {
            var x = padL + (W - padL - padR) * (idx / (chartPoints.length - 1));
            var y = padT + (H - padT - padB) * (1 - (p.price - minP) / range);
            return { x: x, y: y, price: p.price, date: p.date };
          });

          // Draw curve
          ctx.strokeStyle = lineColor;
          ctx.lineWidth = 2.5;
          ctx.lineJoin = 'round';
          ctx.beginPath();
          coords.forEach(function (pt, idx) {
            if (idx === 0) ctx.moveTo(pt.x, pt.y);
            else ctx.lineTo(pt.x, pt.y);
          });
          ctx.stroke();

          // Fill area
          ctx.lineTo(coords[coords.length - 1].x, H - padB);
          ctx.lineTo(coords[0].x, H - padB);
          ctx.closePath();
          var grad = ctx.createLinearGradient(0, padT, 0, H - padB);
          grad.addColorStop(0, isDark ? 'rgba(56,189,248,0.22)' : 'rgba(37,99,235,0.14)');
          grad.addColorStop(1, 'rgba(0,0,0,0)');
          ctx.fillStyle = grad;
          ctx.fill();

          // Draw points
          coords.forEach(function (pt) {
            ctx.fillStyle = lineColor;
            ctx.beginPath();
            ctx.arc(pt.x, pt.y, 4.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.fillStyle = isDark ? '#131a2c' : '#ffffff';
            ctx.beginPath();
            ctx.arc(pt.x, pt.y, 2, 0, Math.PI * 2);
            ctx.fill();
          });

          // Text labels
          ctx.fillStyle = textColor;
          ctx.font = '600 11px system-ui';
          ctx.textAlign = 'right';
          ctx.fillText(maxP.toFixed(2) + ' €', padL - 8, padT + 4);
          ctx.fillText(minP.toFixed(2) + ' €', padL - 8, H - padB);
        }

        render();
        window.addEventListener('resize', render);
      })();
    </script>
  )}
</Base>
