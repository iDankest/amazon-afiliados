---
import Base from '../../layouts/Base.astro';
import AmazonLink from '../../components/AmazonLink.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');
---

<Base title="Tapones espuma vs silicona" description="Espuma vs silicona en tapones para dormir: aislamiento, comodidad de lado y qué pierde cada material.">
  <section class="helm-hero g-hero">
    <div class="helm-header">
      <span class="helm-kicker">Cuaderno de Descanso // Comparativa 06</span>
      <span class="badge">[Sin claims médicos]</span>
    </div>
    <h1>Espuma vs silicona</h1>
    <p class="lede">Cada material aísla y molesta a su manera.</p>
  </section>

  <div class="grid">
    <article class="card">
      <div>
        <div class="card-header-mono">Bando // Espuma</div>
        <h3>Más aislamiento, peor de lado</h3>
        <p>Más aislamiento si ruedas bien el tapón y esperas a que expanda. Incómodo de lado y de un solo uso si se sucia.</p>
      </div>
    </article>
    <article class="card">
      <div>
        <div class="card-header-mono">Bando // Silicona</div>
        <h3>Más comodidad, menos dB</h3>
        <p>Silicona / Loop-like: se lava, se nota menos, a menudo deja pasar más ruido.</p>
      </div>
    </article>
  </div>

  <blockquote class="g-pull">El País y Amazon ES empujan Loop Quiet; es marca, no magia.</blockquote>

  <div class="btn-group">
    <AmazonLink query="tapones espuma dormir">Espuma</AmazonLink>
    <AmazonLink query="tapones silicona dormir">Silicona</AmazonLink>
  </div>

  <div class="g-next">
    <span class="g-next-label">Siguiente rumbo</span>
    <div class="g-next-links">
      <a class="card-link" href={u('guias/tapones-para-dormir/')}>Tapones para dormir <span aria-hidden="true">&rarr;</span></a>
      <a class="card-link" href={u('guias/kit-antifaz-y-tapones/')}>Kit antifaz + tapones <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</Base>

<style>
  .g-hero h1 {
    margin-bottom: 0.75rem;
  }
  .g-hero .lede {
    margin-bottom: 0;
  }
  .g-pull {
    margin: 2.25rem 0;
    padding: 1.1rem 1.4rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
    background: var(--card-alt);
    font-family: 'Cinzel', Georgia, serif;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: balance;
  }
  .g-next {
    margin-top: 3.25rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
  }
  .g-next-label {
    font-family: 'Overpass Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 0.75rem;
  }
  .g-next-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }
</style>
