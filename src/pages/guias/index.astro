---
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');

interface Guia {
  slug: string;
  title: string;
  desc: string;
}

const descanso: Guia[] = [
  { slug: 'antifaz-para-dormir', title: 'Antifaz para dormir', desc: '3D vs plano, velcro, luz por la nariz, dormir de lado.' },
  { slug: 'tapones-para-dormir', title: 'Tapones para dormir', desc: 'Espuma, silicona, reutilizables. Lo que suele fallar.' },
  { slug: 'kit-antifaz-y-tapones', title: 'Kit antifaz + tapones', desc: 'Amazon vende el pack barato. Loop vende tapones caros. El precio no es lo mismo que calidad.' },
  { slug: 'errores-al-comprar-antifaz', title: 'Errores al comprar un antifaz', desc: 'Cinco comprobaciones antes de pagar por oscuridad.' },
  { slug: 'dormir-de-lado', title: 'Dormir de lado con antifaz', desc: 'Presión en el ojo, luz por el borde y la prueba de la linterna.' },
  { slug: 'espuma-vs-silicona', title: 'Tapones: espuma vs silicona', desc: 'Más aislamiento o más comodidad: qué pierde cada material.' },
  { slug: 'barato-vs-caro', title: 'Barato de Amazon vs caro de marca', desc: 'Packs baratos contra marcas «sleep»: qué pagas en cada caso.' },
];

const teclados: Guia[] = [
  { slug: 'teclados', title: 'Teclados mecánicos', desc: 'Guía de compra honesta: switch, tamaño, conexión, layout. Lo no probado se etiqueta.' },
];

---

<Base title="Guías — Orza" description="Índice de guías de Orza: descanso (antifaces, tapones, kits) y teclados. Criterio de compra antes del clic; lo no probado se etiqueta.">
  <section class="g-hero">
    <h1>Guías</h1>
    <p class="lede">Criterio de compra antes del clic: descanso y teclados. Si un producto no se ha probado, se dice en la propia guía.</p>
  </section>

  <h2>Guías de descanso</h2>
  <p class="section-desc">Dormir a oscuras y en silencio, sin inventar milagros.</p>
  <div class="grid">
    {descanso.map((g) => (
      <article class="card">
        <div>
          <div class="card-header-mono">Guía</div>
          <h3>{g.title}</h3>
          <p>{g.desc}</p>
        </div>
        <div class="card-actions">
          <a class="card-link" href={u(`guias/${g.slug}/`)}>Leer guía <span aria-hidden="true">&rarr;</span></a>
        </div>
      </article>
    ))}
  </div>

  <h2>Guías de teclados</h2>
  <p class="section-desc">Criterio táctil para el escritorio; aún sin reviews propias.</p>
  <div class="grid">
    {teclados.map((g) => (
      <article class="card">
        <div>
          <div class="card-header-mono">Guía de compra</div>
          <h3>{g.title}</h3>
          <p>{g.desc}</p>
        </div>
        <div class="card-actions">
          <a class="card-link" href={u(`guias/${g.slug}/`)}>Leer guía <span aria-hidden="true">&rarr;</span></a>
        </div>
      </article>
    ))}
  </div>

</Base>

<style>
  .g-hero {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-subtle);
  }
  .g-hero h1 {
    margin-bottom: 0.75rem;
  }
  .g-hero .lede {
    margin-bottom: 0;
  }
  @media (max-width: 600px) {
    .g-hero {
      padding: 1.25rem;
    }
  }
</style>
