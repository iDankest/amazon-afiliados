---
import Base from '../../layouts/Base.astro';
import AmazonLink from '../../components/AmazonLink.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');

const mirar = [
  { k: 'Switch', t: 'Lineal (suave), táctil (con tope) o clicky (con ruido). El clicky en una habitación compartida es una declaración de guerra.', d: 'No lo he probado: esto es criterio general, no una comparativa propia.' },
  { k: 'Tamaño', t: '60%, TKL o completo. Si usas teclado numérico a diario, un 60% te va a molestar.', d: '' },
  { k: 'Conexión', t: 'Cable, 2.4 GHz o Bluetooth. Para jugar, cable o 2.4 GHz; para escribir en el sofá, Bluetooth.', d: '' },
  { k: 'Keycaps', t: 'El plástico ABS brilla con el uso; el PBT suele aguantar mejor.', d: 'No lo he probado en un modelo concreto.' },
  { k: 'Idioma', t: 'En Amazon.es conviven layouts ES y US. Revisa que el layout sea el que quieres antes de comprar.', d: '' },
];

const noencontraras = [
  'Un "top 10 teclados" sin fuente: no se inventa.',
  'Notas de estrellas propias: aún no existen.',
  'Reviews de teclados que no han pasado por mis manos.',
];
---

<Base title="Teclados mecánicos — guía honesta" description="Qué mirar en un teclado mecánico antes de comprar en Amazon.es. Aún no hay reviews propias: lo no probado se etiqueta.">
  <section class="helm-hero g-hero">
    <div class="helm-header">
      <span class="helm-kicker">Cuaderno de Teclados // Guía de Compra 01</span>
      <span class="badge no">[No lo he probado]</span>
    </div>
    <h1>Teclados mecánicos</h1>
    <p class="lede">Guía de compra honesta. En este sitio todavía <strong>no hay reviews propias de teclados</strong>: aquí solo hay criterio general de compra. Cuando haya un teclado probado de verdad, se dirá; mientras tanto, la etiqueta es <strong>no lo he probado</strong>.</p>
  </section>

  <h2>Qué mirar antes del clic</h2>
  <p class="section-desc">Cinco criterios que deciden la compra.</p>
  <div class="grid">
    {mirar.map((m, i) => (
      <article class="card">
        <div>
          <div class="card-header-mono">Criterio // {String(i + 1).padStart(2, '0')}</div>
          <h3>{m.k}</h3>
          <p>{m.t}</p>
          {m.d && <p class="g-disclaimer"><em>{m.d}</em></p>}
        </div>
      </article>
    ))}
  </div>

  <h2>Lo que no vas a encontrar aquí</h2>
  <p class="section-desc">La honestidad también es una lista de ausencias.</p>
  <ul class="g-list">
    {noencontraras.map((n) => <li>{n}</li>)}
  </ul>

  <div class="btn-group">
    <AmazonLink query="teclado mecanico">Buscar teclado mecánico en Amazon.es</AmazonLink>
  </div>

  <div class="note">
    <span class="note-badge">Nota de Campo</span>
    El botón abre una búsqueda de Amazon.es, no un producto recomendado. Cuando haya reviews propias, se enlazarán desde esta página.
  </div>

  <div class="g-next">
    <span class="g-next-label">Siguiente rumbo</span>
    <div class="g-next-links">
      <a class="card-link" href={u('registro/')}>Registro de precios <span aria-hidden="true">&rarr;</span></a>
      <a class="card-link" href={u('guias/ofertas-semana/')}>Ofertas de la semana <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</Base>

<style>
  .g-hero h1 {
    margin-bottom: 0.75rem;
  }
  .g-hero .lede {
    margin-bottom: 0;
  }
  .g-disclaimer {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }
  .g-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
    display: grid;
    gap: 0.7rem;
  }
  .g-list li {
    position: relative;
    padding-left: 1.5rem;
    margin: 0;
  }
  .g-list li::before {
    content: '▸';
    position: absolute;
    left: 0.2rem;
    color: var(--accent);
  }
  .g-next {
    margin-top: 3.25rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
  }
  .g-next-label {
    font-family: 'Overpass Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 0.75rem;
  }
  .g-next-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }
</style>
