---
import Base from '../../layouts/Base.astro';
import AmazonLink from '../../components/AmazonLink.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');
---

<Base title="Antifaz para dormir — guía" description="Qué mirar en un antifaz 3D: luz, nariz, lado, velcro. Sin claims médicos.">
  <section class="helm-hero g-hero">
    <div class="helm-header">
      <span class="helm-kicker">Cuaderno de Descanso // Guía de Campo 01</span>
      <span class="badge">[Sin claims médicos]</span>
    </div>
    <h1>Antifaz para dormir</h1>
    <p class="lede">Un antifaz no es medicina. Es tela (o 3D) que tapa luz.</p>
  </section>

  <blockquote class="g-pull">Si no tapa, no sirve, da igual el marketing.</blockquote>

  <h2>Qué suele fallar</h2>
  <p class="section-desc">Los puntos donde se cae la mayoría de antifaces.</p>
  <ul class="g-list">
    <li>Luz por el puente de la nariz.</li>
    <li>Presión en ojos y pestañas (los planos baratos).</li>
    <li>Velcro que engancha el pelo.</li>
    <li>Se desplaza si duermes de lado.</li>
    <li>Calor.</li>
  </ul>

  <h2>3D vs plano</h2>
  <p class="section-desc">La forma decide más que el tejido.</p>
  <p>El 3D (copa, no aplasta el ojo) suele ir mejor de lado. El plano de tela es más barato y más fácil que entre luz. En Amazon.es hay de los dos; el precio de 6–12 € no te dice cuál es cuál hasta ver la forma.</p>

  <div class="btn-group">
    <AmazonLink query="antifaz para dormir 3D blackout">Buscar antifaz 3D en Amazon.es</AmazonLink>
  </div>

  <div class="note">
    <span class="note-badge">Nota de Campo</span>
    No hemos lab-testeado cada SKU. Esta página es criterio de compra, no ranking de 50 modelos.
  </div>

  <div class="g-next">
    <span class="g-next-label">Siguiente rumbo</span>
    <div class="g-next-links">
      <a class="card-link" href={u('guias/dormir-de-lado/')}>Dormir de lado con antifaz <span aria-hidden="true">&rarr;</span></a>
      <a class="card-link" href={u('guias/errores-al-comprar-antifaz/')}>Errores al comprar un antifaz <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</Base>

<style>
  .g-hero h1 {
    margin-bottom: 0.75rem;
  }
  .g-hero .lede {
    margin-bottom: 0;
  }
  .g-pull {
    margin: 2.25rem 0;
    padding: 1.1rem 1.4rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
    background: var(--card-alt);
    font-family: 'Cinzel', Georgia, serif;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: balance;
  }
  .g-list {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0;
    display: grid;
    gap: 0.7rem;
  }
  .g-list li {
    position: relative;
    padding-left: 1.5rem;
    margin: 0;
  }
  .g-list li::before {
    content: '▸';
    position: absolute;
    left: 0.2rem;
    color: var(--accent);
  }
  .g-next {
    margin-top: 3.25rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
  }
  .g-next-label {
    font-family: 'Overpass Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 0.75rem;
  }
  .g-next-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }
</style>
