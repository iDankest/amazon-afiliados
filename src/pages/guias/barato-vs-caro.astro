---
import Base from '../../layouts/Base.astro';
import AmazonLink from '../../components/AmazonLink.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');
---

<Base title="Antifaz barato vs caro" description="Barato de Amazon vs caro de marca: packs, Loop Quiet y marcas sleep. Qué pagas en cada rango antes del clic.">
  <section class="g-hero">
    <div class="g-hero-head">
      <span class="badge">Sin claims médicos</span>
    </div>
    <h1>Barato de Amazon vs caro de marca</h1>
    <p class="lede">En Amazon.es hay antifaces y packs a 6–12 € (Gritin, genéricos 3D). Loop Quiet 2 (solo tapones) ronda los 25 €. Marcas «sleep» en UK/US se van a 30–70 €.</p>
  </section>

  <h2>La cuenta</h2>
  <p class="section-desc">El precio de cada rango, puesto contra la almohada.</p>
  <p>Pagar 40 € por un kit genérico de importación no compite con el pack de Amazon. Pagar 25 € por tapones que sí usas cada noche puede valer si el pack de 8 € te los saca a la segunda noche.</p>

  <blockquote class="g-pull">Este sitio no te va a decir que lo caro es mejor. Te pide que mires: ¿lo usarías 30 noches?</blockquote>

  <div class="btn-group">
    <AmazonLink query="antifaz para dormir">Antifaces Amazon.es</AmazonLink>
  </div>

  <div class="g-next">
    <span class="g-next-label">Siguientes guías</span>
    <div class="g-next-links">
      <a class="card-link" href={u('guias/kit-antifaz-y-tapones/')}>Kit antifaz + tapones <span aria-hidden="true">&rarr;</span></a>
      <a class="card-link" href={u('guias/espuma-vs-silicona/')}>Tapones: espuma vs silicona <span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</Base>

<style>
  .g-hero {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-subtle);
  }
  .g-hero-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  
  .g-hero h1 {
    margin-bottom: 0.75rem;
  }
  .g-hero .lede {
    margin-bottom: 0;
  }
  .g-pull {
    margin: 2.25rem 0;
    padding: 1.2rem 1.4rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--card-alt);
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: balance;
  }
  .g-next {
    margin-top: 3.25rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
  }
  .g-next-label {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 0.75rem;
  }
  .g-next-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }
  @media (max-width: 600px) {
    .g-hero {
      padding: 1.25rem;
    }
  }
</style>
