---
import Base from '../../layouts/Base.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import Sparkline from '../../components/Sparkline.astro';
import { products, isRecentMinimum, priceStats, fmtEur, fmtDate, categoryLabel, sortedSnapshots } from '../../lib/catalog';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');

const deals = products
  .filter((p) => isRecentMinimum(p.id))
  .map((p) => ({ p, st: priceStats(p.id), snaps: sortedSnapshots(p.id) }))
  .sort((a, b) => b.st.discountPercent - a.st.discountPercent);
---

<Base
  title="Ofertas y Chollos de la Semana — ORZA"
  description="Selección semanal de ofertas y bajadas de precio reales en Amazon.es respaldadas por datos del tracker."
>
  <section class="g-hero">
    <div class="g-hero-head">
      <span class="deal-badge">{deals.length} chollos detectados</span>
    </div>
    <h1>Chollos y Ofertas de la Semana</h1>
    <p class="lede">
      Descuentos y bajadas de precio reales en Amazon.es. Cada producto listado aquí se encuentra en su mínimo histórico o con un descuento relevante frente a su precio habitual.
    </p>
  </section>

  {deals.length === 0 ? (
    <div class="empty-state">
      <h2 class="empty-state-title">Ahora mismo, no hay ninguna oferta con mínimo detectado</h2>
      <p class="empty-state-text">Aquí solo se listan productos con bajadas comprobadas frente a su histórico registrado.</p>
    </div>
  ) : (
    <div class="products-grid">
      {deals.map(({ p, st, snaps }) => (
        <article class="product-card">
          <div class="product-card-top">
            <span class="product-cat">{categoryLabel[p.category]}</span>
            <span class={`deal-badge ${st.lastIsMin ? 'historic' : ''}`}>
              {st.lastIsMin ? 'MÍNIMO HISTÓRICO' : `-${st.discountPercent}% DESCUENTO`}
            </span>
          </div>

          <h3 class="product-title">
            <a href={u(`p/${p.id}/`)}>{p.title}</a>
          </h3>

          <p class="product-desc">{p.notes}</p>

          <div class="price-block">
            <div class="price-row">
              <span class="price-current">{fmtEur(st.last!.price)}</span>
              {st.max && st.max > st.last!.price && (
                <span class="price-prev">{fmtEur(st.max)}</span>
              )}
            </div>
            <div class="price-meta">
              <span>{st.lastSeenLabel}</span>
              {st.max && st.max > st.last!.price && (
                <span style="color: var(--emerald); font-weight: 700;">
                  Ahorras {fmtEur(st.max - st.last!.price)}
                </span>
              )}
            </div>
          </div>

          {snaps.length >= 2 && (
            <div style="margin-bottom: 0.85rem;">
              <Sparkline
                values={snaps.map((s) => s.price)}
                label={`Evolución de ${p.title}`}
              />
            </div>
          )}

          <div class="product-actions">
            <AmazonLink asin={p.asin} query={p.amazonQuery} class="btn-buy">
              <span>Comprar en Amazon.es</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </AmazonLink>
            <a href={u(`p/${p.id}/`)} class="btn-details">
              Ver histórico y gráfica ({st.count} registros)
            </a>
          </div>
        </article>
      ))}
    </div>
  )}

  <div class="g-next" style="margin-top: 3rem;">
    <span class="g-next-label">Enlaces rápidos</span>
    <div class="g-next-links">
      <a class="card-link" href={u('registro/')}>Registro completo de precios →</a>
      <a class="card-link" href={u('')}>Volver al inicio →</a>
    </div>
  </div>
</Base>

<style>
  .g-hero {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-subtle);
  }
  .g-hero-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  
  .g-hero h1 {
    margin-bottom: 0.75rem;
  }
  .g-hero .lede {
    margin-bottom: 0;
  }
  .g-empty {
    margin: 1.5rem 0;
  }
  .g-empty-title {
    margin: 0.25rem 0 0.85rem;
  }
  .g-empty-title::before {
    content: none;
  }
  .g-next {
    margin-top: 3.25rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
  }
  .g-next-label {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 0.75rem;
  }
  .g-next-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }
  @media (max-width: 600px) {
    .g-hero {
      padding: 1.25rem;
    }
  }
</style>
