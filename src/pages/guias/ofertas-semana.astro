---
import Base from '../../layouts/Base.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import Sparkline from '../../components/Sparkline.astro';
import Icon from '../../components/Icon.astro';
import { products, isRecentMinimum, priceStats, fmtEur, fmtDate, categoryLabel, sortedSnapshots } from '../../lib/catalog';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');

const deals = products
  .filter((p) => isRecentMinimum(p.id))
  .map((p) => ({ p, st: priceStats(p.id), snaps: sortedSnapshots(p.id) }))
  .sort((a, b) => b.st.discountPercent - a.st.discountPercent);
---

<Base
  title="Ofertas y Chollos de la Semana — ORZA"
  description="Selección semanal de ofertas y bajadas de precio reales en Amazon.es respaldadas por datos del tracker."
>
  <section class="g-hero">
    <div class="g-hero-head">
      <span class="deal-badge">{deals.length} chollos detectados</span>
    </div>
    <h1>Chollos y Ofertas de la Semana</h1>
    <p class="lede">
      Descuentos y bajadas de precio reales en Amazon.es. Cada producto listado aquí se encuentra en su mínimo histórico o con un descuento relevante frente a su precio habitual.
    </p>
  </section>

  {deals.length === 0 ? (
    <div class="empty-state">
      <h2 class="empty-state-title">Ahora mismo, no hay ninguna oferta con mínimo detectado</h2>
      <p class="empty-state-text">Aquí solo se listan productos con bajadas comprobadas frente a su histórico registrado.</p>
    </div>
  ) : (
    <div class="cards-grid">
      {deals.map(({ p, st, snaps }) => (
        <article class="deal-card">
          <div>
            <div class="card-top-row">
              <span class="category-pill">{categoryLabel[p.category]}</span>
              <span class={`discount-tag ${st.lastIsMin ? 'historic' : ''}`}>
                {st.lastIsMin ? '🔥 MÍNIMO HISTÓRICO' : `-${st.discountPercent}% REBAJA`}
              </span>
            </div>

            <h3 class="product-name">
              <a href={u(`p/${p.id}/`)}>{p.title}</a>
            </h3>

            <p class="product-snippet">{p.notes}</p>
          </div>

          <div>
            <div class="price-box">
              <div class="price-top-line">
                <span class="price-main">{fmtEur(st.last!.price)}</span>
                {st.max && st.max > st.last!.price && (
                  <span class="price-crossed">{fmtEur(st.max)}</span>
                )}
              </div>
              <div class="price-bottom-line">
                <span>{st.lastSeenLabel}</span>
                {st.max && st.max > st.last!.price && (
                  <span class="savings-highlight">Ahorras {fmtEur(st.max - st.last!.price)}</span>
                )}
              </div>
            </div>

            {snaps.length >= 2 && (
              <div style="margin-bottom: 0.85rem;">
                <Sparkline
                  values={snaps.map((s) => s.price)}
                  label={`Evolución de ${p.title}`}
                />
              </div>
            )}

            <div class="card-buttons">
              <AmazonLink asin={p.asin} query={p.amazonQuery} class="btn-buy-amazon">
                <span>Comprar en Amazon.es</span>
                <Icon name="arrow-up-right" size={15} />
              </AmazonLink>
              <a href={u(`p/${p.id}/`)} class="btn-view-analysis">
                Ver historial de precios ({st.count} comprobaciones) →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  )}

  <div class="g-next" style="margin-top: 3rem;">
    <span class="g-next-label">Enlaces rápidos</span>
    <div class="g-next-links">
      <a class="card-link" href={u('registro/')}>Registro completo de precios →</a>
      <a class="card-link" href={u('')}>Volver al inicio →</a>
    </div>
  </div>
</Base>

<style>
  .g-hero {
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--card);
    padding: 1.75rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow-subtle);
  }
  .g-hero-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  
  .g-hero h1 {
    margin-bottom: 0.75rem;
  }
  .g-hero .lede {
    margin-bottom: 0;
  }
  .g-empty {
    margin: 1.5rem 0;
  }
  .g-empty-title {
    margin: 0.25rem 0 0.85rem;
  }
  .g-empty-title::before {
    content: none;
  }
  .g-next {
    margin-top: 3.25rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--line);
  }
  .g-next-label {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 0.75rem;
  }
  .g-next-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
  }
  @media (max-width: 600px) {
    .g-hero {
      padding: 1.25rem;
    }
  }
</style>
