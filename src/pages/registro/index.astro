---
import Base from "../../layouts/Base.astro";
import { products, categoryLabel, testedLabel } from "../../lib/catalog";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const u = (p: string) => base + p.replace(/^\//, "");

const rows = products.map((p, i) => ({
  no: String(i + 1).padStart(3, "0"),
  p,
}));
---

<Base
  title="Productos Seguidos — ORZA"
  description="Índice de productos seguidos en Amazon.es con ASIN verificado. El histórico de precios lo sirve Keepa en cada ficha; Orza no almacena precios."
>
  <div style="margin-bottom: 2rem;">
    <h1 style="margin: 0 0 0.75rem;">Productos Seguidos</h1>
    <p class="lede" style="margin-bottom: 1.25rem;">
      {rows.length} producto{rows.length === 1 ? "" : "s"} en seguimiento con ASIN verificado en
      Amazon.es. Cada ficha enlaza su histórico de precios real, servido por Keepa en el momento
      de la carga: aquí no se almacena ni se estima ningún precio.
    </p>
  </div>

  <div class="table-wrap">
    <table class="reg">
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">Categoría</th>
          <th scope="col">Producto</th>
          <th scope="col">Estado</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ no, p }) => (
          <tr>
            <td style="color: var(--muted); font-family: ui-monospace, Menlo, monospace;">{no}</td>
            <td style="font-size: 0.8rem; color: var(--muted);">{categoryLabel[p.category]}</td>
            <td>
              <a href={u(`p/${p.id}/`)} style="color: var(--ink); font-weight: 700; text-decoration: none;">{p.title}</a>
              <div style="font-size: 0.72rem; color: var(--muted); margin-top: 0.2rem; font-family: ui-monospace, Menlo, monospace;">
                {p.asin}
              </div>
            </td>
            <td>
              <span class="status-badge">{testedLabel[p.tested ?? "no"]}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>
