---
import Base from '../../layouts/Base.astro';
import Sparkline from '../../components/Sparkline.astro';
import {
  products,
  sortedSnapshots,
  priceStats,
  fmtEur,
  fmtDate,
  testedLabel,
  categoryLabel,
} from '../../lib/catalog';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');

const rows = products.map((p, i) => ({
  no: String(i + 1).padStart(3, '0'),
  p,
  snaps: sortedSnapshots(p.id),
  st: priceStats(p.id),
}));
const totalSnaps = rows.reduce((n, r) => n + r.st.count, 0);
---

<Base title="Registro de precios — Orza" description="Registro propio de precios vistos a mano en Amazon.es: descanso y teclados. Sin scrape, sin precios inventados.">
  <p class="ledger-kicker">Libro de registro // precios vistos a mano</p>
  <h1>Registro de precios</h1>
  <p class="lede">Precios que alguien anotó a mano, con fecha. Nada de scrape ni de cifras inventadas: si un producto no tiene snapshots, no tiene precio aquí.</p>

  <div class="ledger-meta" role="group" aria-label="Resumen del registro">
    <span class="ledger-meta-item">{rows.length} productos en catálogo</span>
    <span class="ledger-meta-sep" aria-hidden="true">·</span>
    <span class="ledger-meta-item">{totalSnaps} anotaciones fechadas</span>
    <span class="ledger-meta-sep" aria-hidden="true">·</span>
    <span class="ledger-meta-item">regla del sitio: sin snapshot no hay cifra</span>
  </div>

  {rows.length === 0 ? (
    <section class="ledger-sheet">
      <div class="ledger-blank">
        <p class="ledger-blank-title">Página en blanco a propósito</p>
        <p class="ledger-blank-sub">El catálogo está vacío. Cuando entre un producto real, aparecerá aquí con su fila y sus anotaciones.</p>
      </div>
    </section>
  ) : (
    <section class="ledger-sheet" aria-label="Libro de registro de precios">
      <table class="ledger">
        <caption class="ledger-caption">Libro de registro: un producto por fila, una anotación por precio visto a mano.</caption>
        <thead>
          <tr>
            <th scope="col" class="ledger-no-head">Nº</th>
            <th scope="col">Producto</th>
            <th scope="col" class="ledger-num-head">Última anotación</th>
            <th scope="col" class="ledger-num-head">Mín / Máx</th>
            <th scope="col">Histórico</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ no, p, snaps, st }) => (
            <tr class={st.count === 0 ? 'is-empty' : undefined}>
              <td data-label="Nº" class="ledger-no">{no}</td>
              <td data-label="Producto" class="ledger-product">
                <a class="ledger-title" href={u(`p/${p.id}/`)}>{p.title}</a>
                <span class="ledger-badges">
                  <span class={`badge ${p.tested}`}>{testedLabel[p.tested]}</span>
                  <span class="badge">{categoryLabel[p.category]}</span>
                </span>
              </td>
              <td data-label="Última anotación" class="ledger-num">
                {st.count === 0 ? (
                  <span class="ledger-nil">—</span>
                ) : (
                  <>
                    <span class={st.isRecent ? 'ledger-price price-now' : 'ledger-price price-seen'}>{fmtEur(st.last!.price)}</span>
                    <span class="ledger-date">visto el {fmtDate(st.last!.date)}</span>
                  </>
                )}
              </td>
              <td data-label="Mín / Máx" class="ledger-num">
                {st.count >= 2 ? (
                  <span class="ledger-range">{fmtEur(st.min!)} / {fmtEur(st.max!)}</span>
                ) : (
                  <span class="ledger-nil">{st.count === 1 ? 'con 2+' : '—'}</span>
                )}
              </td>
              <td data-label="Histórico" class="ledger-spark-cell">
                {st.count >= 2 && snaps.length >= 2 ? (
                  <div class="ledger-spark">
                    <Sparkline values={snaps.map((s) => s.price)} label={`Histórico de ${p.title}: mínimo ${fmtEur(st.min!)}, máximo ${fmtEur(st.max!)}`} />
                  </div>
                ) : (
                  <span class="ledger-nil">{st.count === 1 ? '1 anotación' : 'sin gráfica'}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="ledger-colophon">Mín/Máx y gráfica solo con 2+ anotaciones · si la última tiene 7+ días se lee «visto el {'{fecha}'}», nunca «precio actual»</p>
    </section>
  )}

  <p class="ledger-how">¿Cómo entra una cifra aquí? A mano: alguien ve un precio real en Amazon.es y lo anota con fecha en <code>data/snapshots/</code>. Nada se rellena solo.</p>
</Base>

<style>
  .ledger-kicker {
    font-family: 'Overpass Mono', ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: -0.5rem 0 0.6rem;
  }

  .ledger-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Overpass Mono', ui-monospace, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    color: var(--muted);
    background: var(--card-alt);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0.55rem 0.9rem;
    margin: 0 0 1.25rem;
  }

  .ledger-meta-sep {
    color: var(--accent);
  }

  .ledger-sheet {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 4px;
    box-shadow: var(--shadow-subtle);
    padding: 0.25rem 0.9rem 0.9rem;
    position: relative;
  }

  .ledger-sheet::before,
  .ledger-sheet::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    pointer-events: none;
  }

  .ledger-sheet::before {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--accent);
    border-left: 2px solid var(--accent);
  }

  .ledger-sheet::after {
    bottom: -1px;
    right: -1px;
    border-bottom: 2px solid var(--accent);
    border-right: 2px solid var(--accent);
  }

  .ledger-caption {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  table.ledger {
    width: 100%;
    border-collapse: collapse;
    font-family: 'Overpass Mono', ui-monospace, monospace;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    margin: 0.75rem 0 0;
  }

  table.ledger th {
    text-align: left;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.6rem 0.6rem;
    border-bottom: 2px solid var(--ink);
  }

  .ledger-num-head {
    text-align: right;
  }

  table.ledger td {
    padding: 0.75rem 0.6rem;
    border-bottom: 1px solid var(--line-subtle);
    vertical-align: middle;
  }

  table.ledger tbody tr:last-child td {
    border-bottom: 2px solid var(--ink);
  }

  table.ledger tbody tr:hover {
    background: var(--card-alt);
  }

  .ledger-no {
    color: var(--muted);
    font-size: 0.78rem;
    width: 3rem;
  }

  .ledger-product {
    font-family: 'Albert Sans', system-ui, sans-serif;
  }

  .ledger-title {
    display: block;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.35;
  }

  .ledger-title:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ledger-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }

  .ledger-num {
    text-align: right;
  }

  .ledger-price {
    display: block;
    font-size: 1rem;
  }

  .ledger-date {
    display: block;
    font-size: 0.7rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  .ledger-range {
    white-space: nowrap;
    color: var(--ink);
  }

  .ledger-nil {
    color: var(--muted);
  }

  tr.is-empty .ledger-nil {
    font-style: normal;
    opacity: 0.75;
  }

  .ledger-spark-cell {
    width: 8.5rem;
  }

  .ledger-spark {
    width: 8.5rem;
    color: var(--accent);
    margin-left: auto;
  }

  .ledger-colophon {
    font-family: 'Overpass Mono', ui-monospace, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    border-top: 1px dashed var(--line);
    margin: 0.9rem 0 0;
    padding-top: 0.7rem;
  }

  .ledger-blank {
    border: 1px dashed var(--line);
    border-radius: 4px;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 27px,
      var(--line-subtle) 27px,
      var(--line-subtle) 28px
    );
    padding: 2.5rem 1.25rem;
    text-align: center;
    margin: 0.75rem 0 0;
  }

  .ledger-blank-title {
    font-family: 'Overpass Mono', ui-monospace, monospace;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 0.35rem;
  }

  .ledger-blank-sub {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
  }

  .ledger-how {
    font-size: 0.9rem;
    color: var(--muted);
    margin-top: 1.5rem;
  }

  @media (max-width: 640px) {
    table.ledger thead {
      display: none;
    }

    table.ledger,
    table.ledger tbody,
    table.ledger tr,
    table.ledger td {
      display: block;
      width: 100%;
    }

    table.ledger tbody tr {
      border: 1px solid var(--line);
      border-radius: 4px;
      background: var(--card);
      padding: 0.35rem 0.75rem;
      margin: 0.75rem 0;
    }

    table.ledger tbody tr:hover {
      background: var(--card);
    }

    table.ledger tbody tr:last-child td {
      border-bottom: 1px solid var(--line-subtle);
    }

    table.ledger td {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      border-bottom: 1px solid var(--line-subtle);
      padding: 0.45rem 0;
      text-align: right;
    }

    table.ledger td::before {
      content: attr(data-label);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      text-align: left;
      flex-shrink: 0;
    }

    .ledger-no {
      display: none;
    }

    .ledger-product {
      display: block;
    }

    .ledger-product::before {
      content: none;
    }

    .ledger-title {
      text-align: right;
    }

    .ledger-badges {
      justify-content: flex-end;
    }

    .ledger-spark-cell .ledger-spark {
      margin-left: 0;
    }
  }
</style>
