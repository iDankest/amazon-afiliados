---
import Base from '../../layouts/Base.astro';
import Sparkline from '../../components/Sparkline.astro';
import {
  products,
  sortedSnapshots,
  priceStats,
  fmtEur,
  fmtDate,
  testedLabel,
  categoryLabel,
} from '../../lib/catalog';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');

const rows = products.map((p, i) => ({
  no: String(i + 1).padStart(3, '0'),
  p,
  snaps: sortedSnapshots(p.id),
  st: priceStats(p.id),
}));
const totalSnaps = rows.reduce((n, r) => n + r.st.count, 0);
---

<Base title="Registro de precios — Orza" description="Registro propio de precios vistos a mano en Amazon.es: descanso y teclados. Sin scrape, sin precios inventados.">
  <p class="reg-kicker">Precios vistos a mano</p>
  <h1>Registro de precios</h1>
  <p class="lede">Precios que alguien anotó a mano, con fecha. Nada de scrape ni de cifras inventadas: si un producto no tiene snapshots, no tiene precio aquí.</p>

  <div class="reg-meta" role="group" aria-label="Resumen del registro">
    <span class="reg-meta-item">{rows.length} productos en catálogo</span>
    <span class="reg-meta-sep" aria-hidden="true">·</span>
    <span class="reg-meta-item">{totalSnaps} anotaciones fechadas</span>
    <span class="reg-meta-sep" aria-hidden="true">·</span>
    <span class="reg-meta-item">regla del sitio: sin snapshot no hay cifra</span>
  </div>

  {totalSnaps === 0 ? (
    <section class="empty-state" aria-label="Registro sin anotaciones">
      <h2 class="empty-state-title">El registro empieza en blanco</h2>
      <p class="empty-state-text">
        Solo se publica lo que alguien ha visto con sus ojos y anotado con fecha. Todavía no hay ninguna anotación, así que aquí no hay precios — y no va a haberlos por inercia.
      </p>
      <ol class="empty-state-steps">
        <li><strong>Ver</strong> un precio real en Amazon.es, a mano.</li>
        <li><strong>Anotar</strong> la cifra y la fecha: <code>node scripts/add-snapshot.mjs --id &lt;id&gt; --price &lt;n&gt;</code></li>
        <li><strong>Publicar</strong> con <code>npm run validate:data</code>: la cifra aparece con su fecha, nunca como «precio actual».</li>
      </ol>
      {rows.length > 0 && (
        <div class="empty-state-waiting">
          <p class="empty-state-waiting-label">A la espera de su primera anotación</p>
          <ul class="empty-state-waiting-list">
            {rows.map(({ p }) => (
              <li><a href={u(`p/${p.id}/`)}>{p.title}</a></li>
            ))}
          </ul>
        </div>
      )}
    </section>
  ) : (
    <section class="reg-sheet" aria-label="Registro de precios">
      <table class="reg">
        <caption class="reg-caption">Registro: un producto por fila, una anotación por precio visto a mano.</caption>
        <thead>
          <tr>
            <th scope="col" class="reg-no-head">Nº</th>
            <th scope="col">Producto</th>
            <th scope="col" class="reg-num-head">Última anotación</th>
            <th scope="col" class="reg-num-head">Mín / Máx</th>
            <th scope="col">Histórico</th>
          </tr>
        </thead>
        <tbody>
          {rows.map(({ no, p, snaps, st }) => (
            <tr class={st.count === 0 ? 'is-empty' : undefined}>
              <td data-label="Nº" class="reg-no">{no}</td>
              <td data-label="Producto" class="reg-product">
                <a class="reg-title" href={u(`p/${p.id}/`)}>{p.title}</a>
                <span class="reg-badges">
                  <span class={`badge ${p.tested}`}>{testedLabel[p.tested]}</span>
                  <span class="badge">{categoryLabel[p.category]}</span>
                </span>
              </td>
              <td data-label="Última anotación" class="reg-num">
                {st.count === 0 ? (
                  <span class="reg-nil">—</span>
                ) : (
                  <>
                    <span class={st.isRecent ? 'reg-price price-now' : 'reg-price price-seen'}>{fmtEur(st.last!.price)}</span>
                    <span class="reg-date">visto el {fmtDate(st.last!.date)}</span>
                  </>
                )}
              </td>
              <td data-label="Mín / Máx" class="reg-num">
                {st.count >= 2 ? (
                  <span class="reg-range">{fmtEur(st.min!)} / {fmtEur(st.max!)}</span>
                ) : (
                  <span class="reg-nil">{st.count === 1 ? 'con 2+' : '—'}</span>
                )}
              </td>
              <td data-label="Histórico" class="reg-spark-cell">
                {st.count >= 2 && snaps.length >= 2 ? (
                  <div class="reg-spark">
                    <Sparkline values={snaps.map((s) => s.price)} label={`Histórico de ${p.title}: mínimo ${fmtEur(st.min!)}, máximo ${fmtEur(st.max!)}`} />
                  </div>
                ) : (
                  <span class="reg-nil">{st.count === 1 ? '1 anotación' : 'sin gráfica'}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="reg-colophon">Mín/Máx y gráfica solo con 2+ anotaciones · si la última tiene 7+ días se lee «visto el {'{fecha}'}», nunca «precio actual»</p>
    </section>
  )}
</Base>

<style>
  .reg-kicker {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin: -0.5rem 0 0.6rem;
  }

  .reg-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    color: var(--muted);
    background: var(--card-alt);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.55rem 0.9rem;
    margin: 0 0 1.25rem;
  }

  .reg-meta-sep {
    color: var(--accent);
  }

  .reg-sheet {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow-subtle);
    padding: 0.25rem 0.9rem 0.9rem;
  }

  .reg-caption {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  table.reg {
    width: 100%;
    border-collapse: collapse;
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    margin: 0.75rem 0 0;
  }

  table.reg th {
    text-align: left;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0.6rem 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .reg-num-head {
    text-align: right;
  }

  table.reg td {
    padding: 0.75rem 0.6rem;
    border-bottom: 1px solid var(--line-subtle);
    vertical-align: middle;
  }

  table.reg tbody tr:last-child td {
    border-bottom: 1px solid var(--line-subtle);
  }

  table.reg tbody tr:hover {
    background: var(--card-alt);
  }

  .reg-no {
    color: var(--muted);
    font-size: 0.78rem;
    width: 3rem;
  }

  .reg-product {
    font-family: inherit;
  }

  .reg-title {
    display: block;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.35;
  }

  .reg-title:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .reg-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.4rem;
  }

  .reg-num {
    text-align: right;
  }

  .reg-price {
    display: block;
    font-size: 1rem;
  }

  .reg-date {
    display: block;
    font-size: 0.7rem;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  .reg-range {
    white-space: nowrap;
    color: var(--ink);
  }

  .reg-nil {
    color: var(--muted);
  }

  tr.is-empty .reg-nil {
    font-style: normal;
    opacity: 0.75;
  }

  .reg-spark-cell {
    width: 8.5rem;
  }

  .reg-spark {
    width: 8.5rem;
    color: var(--accent);
    margin-left: auto;
  }

  .reg-colophon {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    border-top: 1px dashed var(--line);
    margin: 0.9rem 0 0;
    padding-top: 0.7rem;
  }

  .reg-empty {
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: var(--shadow-subtle);
    padding: 1.75rem 1.6rem;
  }

  .reg-empty-title {
    font-family: 'Outfit', system-ui, sans-serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 0.4rem;
  }

  .reg-empty-text {
    font-size: 0.98rem;
    color: var(--muted);
    margin: 0 0 1.25rem;
    max-width: 55ch;
  }

  .reg-empty-steps {
    margin: 0 0 1.5rem;
    padding-left: 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .reg-empty-steps strong {
    font-weight: 600;
  }

  .reg-empty-steps code {
    font-family: ui-monospace, 'SF Mono', 'Cascadia Code', Menlo, monospace;
    font-size: 0.82rem;
    background: var(--card-alt);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.15rem 0.45rem;
    word-break: break-all;
  }

  .reg-empty-waiting {
    border-top: 1px solid var(--line-subtle);
    padding-top: 1.1rem;
  }

  .reg-empty-waiting-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.5rem;
  }

  .reg-empty-waiting-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.95rem;
  }


  @media (max-width: 640px) {
    table.reg thead {
      display: none;
    }

    table.reg,
    table.reg tbody,
    table.reg tr,
    table.reg td {
      display: block;
      width: 100%;
    }

    table.reg tbody tr {
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--card);
      padding: 0.35rem 0.75rem;
      margin: 0.75rem 0;
    }

    table.reg tbody tr:hover {
      background: var(--card);
    }

    table.reg tbody tr:last-child td {
      border-bottom: 1px solid var(--line-subtle);
    }

    table.reg td {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1rem;
      border-bottom: 1px solid var(--line-subtle);
      padding: 0.45rem 0;
      text-align: right;
    }

    table.reg td::before {
      content: attr(data-label);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      text-align: left;
      flex-shrink: 0;
    }

    .reg-no {
      display: none;
    }

    .reg-product {
      display: block;
    }

    .reg-product::before {
      content: none;
    }

    .reg-title {
      text-align: right;
    }

    .reg-badges {
      justify-content: flex-end;
    }

    .reg-spark-cell .reg-spark {
      margin-left: 0;
    }
  }
</style>
