---
import Base from '../layouts/Base.astro';
import AmazonLink from '../components/AmazonLink.astro';
import { products, testedLabel, type Category } from '../lib/catalog';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p: string) => base + p.replace(/^\//, '');

const byCat = (c: Category) => products.filter((p) => p.category === c);
const descanso = byCat('descanso');
const teclados = byCat('teclados');
---

<Base title="Orza — guías y registro de precios para Amazon.es" description="Guías honestas de descanso y teclados, y un registro de precios vistos a mano en Amazon.es. Si no se ha probado, se dice. Sin claims médicos.">
  <section class="hero">
    <h1>Orza</h1>
    <p class="lede">
      Guías de descanso y teclados, y un registro de precios vistos en Amazon.es.
      Lo que no se ha probado se etiqueta como tal; sin anotación con fecha, no hay cifra.
    </p>
    <p class="hero-actions">
      <a class="btn" href="#descanso">Descanso</a>
      <a class="btn btn-ghost" href="#teclados">Teclados</a>
    </p>
  </section>

  <h2 id="descanso">Descanso</h2>
  <p class="section-desc">Dormir a oscuras y en silencio: antifaces, tapones y kits. Sin promesas médicas.</p>
  <div class="grid">
    <article class="card">
      <div>
        <div class="card-header-mono">Guía</div>
        <h3>Antifaz para dormir</h3>
        <p>3D vs plano, velcro, luz por la nariz, dormir de lado.</p>
      </div>
      <div class="card-actions">
        <a class="card-link" href={u('guias/antifaz-para-dormir/')}>Leer guía <span aria-hidden="true">&rarr;</span></a>
      </div>
    </article>

    <article class="card">
      <div>
        <div class="card-header-mono">Guía</div>
        <h3>Tapones para dormir</h3>
        <p>Espuma, silicona, reutilizables. Lo que suele fallar.</p>
      </div>
      <div class="card-actions">
        <a class="card-link" href={u('guias/tapones-para-dormir/')}>Leer guía <span aria-hidden="true">&rarr;</span></a>
      </div>
    </article>

    <article class="card">
      <div>
        <div class="card-header-mono">Comparativa</div>
        <h3>¿Kit o por separado?</h3>
        <p>Amazon vende el pack barato. Loop vende tapones caros. El precio no es lo mismo que calidad.</p>
      </div>
      <div class="card-actions">
        <a class="card-link" href={u('guias/kit-antifaz-y-tapones/')}>Comparar <span aria-hidden="true">&rarr;</span></a>
      </div>
    </article>
  </div>

  {descanso.length > 0 && (
    <>
      <h2>Productos seguidos</h2>
      <div class="note">
        <span class="note-badge">Cómo funciona el registro</span>
        Los precios se anotan a mano, con fecha. Sin snapshots anotados no se publica ninguna cifra: esto es un registro, no una oferta.
      </div>
      <div class="grid">
        {descanso.map((p) => (
          <article class="card">
            <div>
              <div class="card-header-mono">Producto seguido</div>
              <h3><a href={u(`p/${p.id}/`)}>{p.title}</a></h3>
              <p><span class={`badge ${p.tested}`}>{testedLabel[p.tested]}</span></p>
              <p>{p.notes}</p>
            </div>
            <div class="card-actions">
              <a class="card-link" href={u(`p/${p.id}/`)}>Ver ficha y registro <span aria-hidden="true">&rarr;</span></a>
            </div>
          </article>
        ))}
      </div>
    </>
  )}

  <h2 id="teclados">Teclados</h2>
  <p class="section-desc">Criterio para el escritorio: switches, formatos y conexión. Aún sin reviews propias.</p>
  <div class="grid">
    <article class="card">
      <div>
        <div class="card-header-mono">Guía</div>
        <h3>Teclados mecánicos</h3>
        <p>Guía de compra honesta: switch, tamaño, conexión, layout. Lo no probado se etiqueta.</p>
      </div>
      <div class="card-actions">
        <a class="card-link" href={u('guias/teclados/')}>Leer guía <span aria-hidden="true">&rarr;</span></a>
      </div>
    </article>
    {teclados.map((p) => (
      <article class="card">
        <div>
          <div class="card-header-mono">Producto seguido</div>
          <h3><a href={u(`p/${p.id}/`)}>{p.title}</a></h3>
          <p><span class={`badge ${p.tested}`}>{testedLabel[p.tested]}</span></p>
          <p>{p.notes}</p>
        </div>
        <div class="card-actions">
          <a class="card-link" href={u(`p/${p.id}/`)}>Ver ficha y registro <span aria-hidden="true">&rarr;</span></a>
        </div>
      </article>
    ))}
  </div>

  <h2>Buscar en Amazon.es</h2>
  <p class="section-desc">Búsquedas directas, no un producto concreto:</p>
  <div class="btn-group">
    <AmazonLink query="antifaz para dormir 3D">Antifaces 3D</AmazonLink>
    <AmazonLink query="tapones oidos para dormir">Tapones para dormir</AmazonLink>
    <AmazonLink query="loop quiet 2">Loop Quiet 2</AmazonLink>
    <AmazonLink query="teclado mecanico">Teclados mecánicos</AmazonLink>
  </div>
  <div class="note">
    <span class="note-badge">Aviso de afiliación</span>
    Estos botones abren búsquedas en Amazon.es. Si hay tag de afiliado activo, comprar dentro de la ventana de atribución puede generar comisión, sin coste extra para ti.
  </div>
</Base>

<style>
  .hero {
    margin-bottom: 1rem;
  }

  .hero .lede {
    margin-bottom: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0 0 1rem;
  }
</style>
