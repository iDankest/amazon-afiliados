---
import Base from "../layouts/Base.astro";
import AmazonLink from "../components/AmazonLink.astro";
import Sparkline from "../components/Sparkline.astro";
import { products, priceStats, fmtEur, categoryLabel, sortedSnapshots } from "../lib/catalog";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const u = (p: string) => base + p.replace(/^\//, "");

// Precalcular estadísticas
const allProductsWithStats = products.map((p) => {
  const st = priceStats(p.id);
  const snaps = sortedSnapshots(p.id);
  return { p, st, snaps };
});

// Chollos y mínimos
const deals = [...allProductsWithStats]
  .filter(({ st }) => st.count > 0 && (st.lastIsMin || st.discountPercent > 0))
  .sort((a, b) => b.st.discountPercent - a.st.discountPercent);

const totalTracked = products.length;
const totalDeals = deals.length;
const maxSavings = deals.reduce((max, d) => {
  if (d.st.max && d.st.last) {
    const diff = d.st.max - d.st.last.price;
    return diff > max ? diff : max;
  }
  return max;
}, 0);
---

<Base
  title="ORZA // Terminal de Inteligencia de Precios en Amazon.es"
  description="Terminal de datos y seguimiento de precios en Amazon.es. Detección cuantitativa de mínimos históricos, cálculo de ahorro y compras directas."
>
  <!-- Terminal Hero -->
  <section class="terminal-hero" aria-label="Terminal de Precios">
    <div class="terminal-head">
      <div class="terminal-status-beacon">
        <span class="beacon-dot" aria-hidden="true"></span>
        <span>EN VIVO · AMAZON.ES FEED</span>
      </div>
      <div class="terminal-time">ACTUALIZACIÓN CONTINUA</div>
    </div>

    <h1 class="terminal-title">Terminal de Precios y Cotizaciones en Amazon.es</h1>
    <p class="terminal-desc">
      Análisis cuantitativo de precios sin opiniones ficticias. Monitorizamos el historial de cotizaciones para que compres en el punto más bajo del mercado.
    </p>

    <!-- Ticker de Métricas de Mercado -->
    <div class="ticker-grid">
      <div class="ticker-cell">
        <span class="ticker-label">En Mínimo Histórico</span>
        <span class="ticker-val" style="color: var(--emerald);">{totalDeals}</span>
        <span class="ticker-sub">Oportunidades activas</span>
      </div>
      <div class="ticker-cell">
        <span class="ticker-label">Referencias Activas</span>
        <span class="ticker-val">{totalTracked}</span>
        <span class="ticker-sub">Catálogo verificado</span>
      </div>
      <div class="ticker-cell">
        <span class="ticker-label">Ahorro Máximo</span>
        <span class="ticker-val" style="color: var(--accent);">{fmtEur(maxSavings)}</span>
        <span class="ticker-sub">Frente a picos históricos</span>
      </div>
      <div class="ticker-cell">
        <span class="ticker-label">Tipo de Cotización</span>
        <span class="ticker-val" style="font-size: 0.95rem; font-weight: 700; color: var(--ink-secondary);">SNAPSHOTS</span>
        <span class="ticker-sub">Con fecha y ASIN</span>
      </div>
    </div>

    <!-- Command Palette de Búsqueda -->
    <div class="command-box" role="search">
      <div class="command-input-wrap">
        <svg class="command-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="product-search"
          class="command-input"
          placeholder="Filtrar por producto, modelo o categoría (MX Master, Epomaker, ANC, Loop)..."
          aria-label="Buscar en la terminal de precios"
        />
        <kbd class="command-kbd" title="Presiona / para enfocar">/</kbd>
      </div>
      <button type="button" id="search-action-btn" class="command-btn">
        <span>Buscar</span>
      </button>
    </div>

    <!-- Filtro de Categorías -->
    <div class="filter-tabs" role="tablist" aria-label="Filtrar por categoría">
      <button type="button" class="filter-tab active" data-cat="all">Todos ({totalTracked})</button>
      <button type="button" class="filter-tab" data-cat="teclados">Teclados</button>
      <button type="button" class="filter-tab" data-cat="perifericos">Periféricos & Setup</button>
      <button type="button" class="filter-tab" data-cat="audio">Audio & ANC</button>
      <button type="button" class="filter-tab" data-cat="descanso">Descanso & Salud</button>
    </div>
  </section>

  <!-- Sección Chollos y Mínimos -->
  <section id="chollos" aria-label="Chollos y Mínimos">
    <div class="section-header">
      <h2>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline>
          <polyline points="17 18 23 18 23 12"></polyline>
        </svg>
        <span>Mínimos Históricos y Bajadas de Precio</span>
      </h2>
      <a class="section-link" href={u("registro/")}>Base de datos completa →</a>
    </div>

    <div class="terminal-grid" id="deals-grid">
      {deals.map(({ p, st, snaps }) => (
        <article class="terminal-card" data-category={p.category} data-title={p.title.toLowerCase()}>
          <div>
            <div class="card-meta-row">
              <span class="cat-tag">{categoryLabel[p.category]}</span>
              <span class={`status-badge ${st.lastIsMin ? "historic" : ""}`}>
                {st.lastIsMin ? "MÍNIMO HISTÓRICO" : `-${st.discountPercent}% DESCUENTO`}
              </span>
            </div>

            <h3 class="card-title">
              <a href={u(`p/${p.id}/`)}>{p.title}</a>
            </h3>

            <p class="card-notes">{p.notes}</p>
          </div>

          <div>
            <div class="price-display">
              <div class="price-main-line">
                <span class="price-now">{fmtEur(st.last!.price)}</span>
                {st.max && st.max > st.last!.price && (
                  <span class="price-was">{fmtEur(st.max)}</span>
                )}
              </div>
              <div class="price-sub-line">
                <span>{st.lastSeenLabel}</span>
                {st.max && st.max > st.last!.price && (
                  <span class="price-delta">Ahorras {fmtEur(st.max - st.last!.price)}</span>
                )}
              </div>
            </div>

            {snaps.length >= 2 && (
              <div style="margin-bottom: 0.85rem;">
                <Sparkline
                  values={snaps.map((s) => s.price)}
                  label={`Evolución de ${p.title}`}
                />
              </div>
            )}

            <div class="card-actions">
              <AmazonLink asin={p.asin} query={p.amazonQuery} class="btn-terminal-buy">
                <span>Comprar en Amazon.es</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </AmazonLink>
              <a href={u(`p/${p.id}/`)} class="btn-terminal-details">
                Análisis de precio ({st.count} snapshots) →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Spotlight Callout -->
  <section class="spotlight-box" aria-label="Cotización Destacada">
    <div class="spotlight-info">
      <h3 class="spotlight-heading">Logitech MX Master 3S en Cotización Mínima</h3>
      <p class="spotlight-text">
        El estándar en ergonomía y precisión de Logitech se encuentra actualmente en su cotización más baja registrada.
      </p>
    </div>
    <AmazonLink asin="B07W4DGBMC" query="logitech mx master 3s" class="btn-terminal-buy" style="padding: 0.65rem 1.25rem;">
      <span>Ver cotización en Amazon.es →</span>
    </AmazonLink>
  </section>

  <!-- Catálogo General Monitoreado -->
  <section id="tops" aria-label="Catálogo Monitoreado">
    <div class="section-header">
      <h2>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Todos los Productos en Seguimiento</span>
      </h2>
    </div>

    <div class="terminal-grid" id="catalog-grid">
      {allProductsWithStats.map(({ p, st }) => (
        <article class="terminal-card" data-category={p.category} data-title={p.title.toLowerCase()}>
          <div>
            <div class="card-meta-row">
              <span class="cat-tag">{categoryLabel[p.category]}</span>
              {p.badge && <span class="status-badge">{p.badge}</span>}
            </div>

            <h3 class="card-title">
              <a href={u(`p/${p.id}/`)}>{p.title}</a>
            </h3>

            <p class="card-notes">{p.notes}</p>
          </div>

          <div>
            <div class="price-display">
              <div class="price-main-line">
                <span class="price-now">{st.count > 0 ? fmtEur(st.last!.price) : "—"}</span>
                {st.count >= 2 && (
                  <span class="price-was">{fmtEur(st.max!)}</span>
                )}
              </div>
              <div class="price-sub-line">
                <span>{st.lastSeenLabel}</span>
                {st.count >= 2 && (
                  <span>Rango: {fmtEur(st.min!)} – {fmtEur(st.max!)}</span>
                )}
              </div>
            </div>

            <div class="card-actions">
              <AmazonLink asin={p.asin} query={p.amazonQuery} class="btn-terminal-buy">
                <span>Comprar en Amazon.es</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </AmazonLink>
              <a href={u(`p/${p.id}/`)} class="btn-terminal-details">
                Ver gráfica e histórico ({st.count} registros) →
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Buscador Directo de Categorías en Amazon -->
  <section id="buscador" aria-label="Búsqueda Directa" style="margin-top: 3rem;">
    <div class="section-header">
      <h2>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
        </svg>
        <span>Accesos Directos a Amazon.es</span>
      </h2>
    </div>

    <div class="terminal-grid" style="grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));">
      <div class="terminal-card" style="gap: 0.5rem;">
        <span class="cat-tag">Categoría</span>
        <h3 class="card-title">Teclados Mecánicos Hot-Swap</h3>
        <p class="card-notes">Switches mecánicos, formatos 60%, 75% y TKL.</p>
        <AmazonLink query="teclados mecanicos hot swap espana" class="btn-terminal-buy">
          <span>Buscar en Amazon →</span>
        </AmazonLink>
      </div>
      <div class="terminal-card" style="gap: 0.5rem;">
        <span class="cat-tag">Categoría</span>
        <h3 class="card-title">Auriculares Cancelación Ruido</h3>
        <p class="card-notes">Modelos inalámbricos con tecnología ANC.</p>
        <AmazonLink query="auriculares cancelacion ruido anc" class="btn-terminal-buy">
          <span>Buscar en Amazon →</span>
        </AmazonLink>
      </div>
      <div class="terminal-card" style="gap: 0.5rem;">
        <span class="cat-tag">Categoría</span>
        <h3 class="card-title">Ergonomía & Setup</h3>
        <p class="card-notes">Brazos para monitor y periféricos de productividad.</p>
        <AmazonLink query="ergonomia setup escritorio brazo monitor" class="btn-terminal-buy">
          <span>Buscar en Amazon →</span>
        </AmazonLink>
      </div>
      <div class="terminal-card" style="gap: 0.5rem;">
        <span class="cat-tag">Categoría</span>
        <h3 class="card-title">Descanso & Aislamiento</h3>
        <p class="card-notes">Tapones con filtro acústico y antifaces opacos 3D.</p>
        <AmazonLink query="tapones oido dormir antifaz 3d" class="btn-terminal-buy">
          <span>Buscar en Amazon →</span>
        </AmazonLink>
      </div>
    </div>
  </section>

  <!-- Script interactivo de filtrado -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById("product-search");
      const searchBtn = document.getElementById("search-action-btn");
      const catBtns = document.querySelectorAll(".filter-tab");
      const cards = document.querySelectorAll("#catalog-grid .terminal-card, #deals-grid .terminal-card");

      let currentCat = "all";
      let searchQuery = "";

      function filterCards() {
        cards.forEach((card) => {
          const cardCat = card.getAttribute("data-category") || "";
          const cardTitle = card.getAttribute("data-title") || "";

          const matchesCat = currentCat === "all" || cardCat === currentCat;
          const matchesSearch = searchQuery === "" || cardTitle.includes(searchQuery);

          if (matchesCat && matchesSearch) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      }

      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = (e.target.value || "").trim().toLowerCase();
          filterCards();
        });

        window.addEventListener("keydown", (e) => {
          if (e.key === "/" && document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput.focus();
          }
        });
      }

      if (searchBtn && searchInput) {
        searchBtn.addEventListener("click", () => {
          const val = searchInput.value.trim();
          if (val) {
            location.href = "#tops";
          }
        });
      }

      catBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          catBtns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          currentCat = btn.getAttribute("data-cat") || "all";
          filterCards();
        });
      });
    })();
  </script>
</Base>
