---
import Base from "../layouts/Base.astro";
import AmazonLink from "../components/AmazonLink.astro";
import Sparkline from "../components/Sparkline.astro";
import Icon from "../components/Icon.astro";
import ProductImage from "../components/ProductImage.astro";
import { products, priceStats, fmtEur, categoryLabel, sortedSnapshots } from "../lib/catalog";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const u = (p: string) => base + p.replace(/^\//, "");

const allProductsWithStats = products.map((p) => {
  const st = priceStats(p.id);
  const snaps = sortedSnapshots(p.id);
  return { p, st, snaps };
});

const deals = [...allProductsWithStats]
  .filter(({ st }) => st.count > 0 && (st.lastIsMin || st.discountPercent > 0))
  .sort((a, b) => b.st.discountPercent - a.st.discountPercent);

const suggestions = allProductsWithStats.slice(0, 3);
---

<Base
  title="ORZA — Encuentra el Mejor Precio en Amazon.es"
  description="Busca productos en Amazon.es, compara precios históricos y detecta el momento exacto para comprar al mínimo."
>
  <!-- Hero Search Showcase (inspirado en Stitch) -->
  <section class="hero-stitch-card" aria-label="Buscador de Precios y Chollos">
    <h1 class="hero-stitch-headline">Encuentra el mejor precio. Siempre.</h1>
    <p class="hero-stitch-subtitle">
      Busca productos en Amazon.es, compara precios históricos y compra en el momento exacto en que tocan su mínimo.
    </p>

    <!-- Search Input Box -->
    <div class="stitch-search-wrap" role="search">
      <div class="stitch-search-input-box">
        <Icon name="search" size={18} class="search-icon-svg" />
        <input
          type="search"
          id="product-search"
          class="stitch-search-input"
          placeholder="Busca productos de Amazon, ASIN o marca (MX Master, Epomaker, ANC, Loop)..."
          aria-label="Buscar productos en el catálogo"
        />
      </div>
      <button type="button" id="search-action-btn" class="stitch-search-btn">
        <Icon name="search" size={16} />
        <span>Buscar Chollo</span>
      </button>
    </div>

    <!-- Quick Search Chips -->
    <div class="quick-search-tags">
      <span>Tendencias:</span>
      <button type="button" class="quick-tag-chip" data-term="MX Master 3S">MX Master 3S</button>
      <button type="button" class="quick-tag-chip" data-term="Epomaker">Epomaker TH80</button>
      <button type="button" class="quick-tag-chip" data-term="Sony WH-1000XM5">Sony ANC</button>
      <button type="button" class="quick-tag-chip" data-term="Loop Quiet">Loop Quiet</button>
      <button type="button" class="quick-tag-chip" data-term="Antifaz">Antifaz 3D</button>
      <button type="button" class="quick-tag-chip" data-term="60%">Teclado 60%</button>
    </div>
  </section>

  <!-- Two-Column App Layout -->
  <div class="app-layout">
    <!-- Sidebar -->
    <aside class="sidebar-sticky" aria-label="Filtros y Sugerencias">
      <!-- Categorías -->
      <div class="sidebar-box">
        <h2 class="sidebar-heading">
          <Icon name="grid" size={16} />
          <span>Categorías</span>
        </h2>
        <div class="category-nav-list" role="tablist">
          <button type="button" class="category-filter-btn active" data-cat="all">
            <span>Todos los productos</span>
            <span class="category-count">{products.length}</span>
          </button>
          <button type="button" class="category-filter-btn" data-cat="teclados">
            <span>Teclados Mecánicos</span>
            <span class="category-count">2</span>
          </button>
          <button type="button" class="category-filter-btn" data-cat="perifericos">
            <span>Periféricos & Setup</span>
            <span class="category-count">2</span>
          </button>
          <button type="button" class="category-filter-btn" data-cat="audio">
            <span>Audio & Auriculares</span>
            <span class="category-count">1</span>
          </button>
          <button type="button" class="category-filter-btn" data-cat="descanso">
            <span>Descanso & Salud</span>
            <span class="category-count">3</span>
          </button>
        </div>
      </div>

      <!-- Sugerencias de Mínimos -->
      <div class="sidebar-box">
        <h2 class="sidebar-heading">
          <Icon name="sparkles" size={16} style="color: var(--amber);" />
          <span>Sugerencias Top</span>
        </h2>
        <div>
          {suggestions.map(({ p, st }) => (
            <div class="suggestion-item" style="display: flex; flex-direction: row; gap: 0.75rem; align-items: center;">
              {p.asin && <ProductImage asin={p.asin} title={p.title} size="sm" />}
              <div style="flex: 1; min-width: 0;">
                <span class="suggestion-tag">{categoryLabel[p.category]}</span>
                <a href={u(`p/${p.id}/`)} class="suggestion-title" style="display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">{p.title}</a>
                <span class="suggestion-price">{st.count > 0 ? fmtEur(st.last!.price) : "—"}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </aside>

    <!-- Main Feed -->
    <main style="padding: 0;">
      <!-- Feed Header -->
      <div class="feed-header">
        <div>
          <h2 class="feed-title">
            <Icon name="trending-down" size={22} style="color: var(--coral);" />
            <span>Bajadas de Precio del Día</span>
          </h2>
          <p class="feed-subtitle">Monitorizamos los productos periódicamente. Precios comprobados frente a históricos reales.</p>
        </div>
        <a class="section-link" href={u("registro/")}>
          <span>Ver registro completo</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>

      <!-- Feed Grid -->
      <div class="products-feed-grid" id="main-products-grid">
        {deals.map(({ p, st, snaps }) => (
          <article class="stitch-card" data-category={p.category} data-title={p.title.toLowerCase()}>
            <div>
              <div class="stitch-card-top">
                <span class="stitch-cat-label">{categoryLabel[p.category]}</span>
                <span class={`stitch-discount-badge ${st.lastIsMin ? "historic" : ""}`}>
                  {st.lastIsMin ? "🔥 MÍNIMO HISTÓRICO" : `-${st.discountPercent}% REBAJA`}
                </span>
              </div>

              {p.asin && (
                <a href={u(`p/${p.id}/`)} style="text-decoration: none; display: block;">
                  <ProductImage asin={p.asin} title={p.title} size="md" />
                </a>
              )}

              <h3 class="stitch-card-title">
                <a href={u(`p/${p.id}/`)}>{p.title}</a>
              </h3>

              <p class="stitch-card-desc">{p.notes}</p>
            </div>

            <div>
              <div class="stitch-price-box">
                <div class="stitch-price-row">
                  <span class="stitch-price-now">{fmtEur(st.last!.price)}</span>
                  {st.max && st.max > st.last!.price && (
                    <span class="stitch-price-was">{fmtEur(st.max)}</span>
                  )}
                </div>
                <div class={`stitch-price-beacon ${st.lastIsMin ? "historic" : ""}`}>
                  <span class="beacon-dot"></span>
                  <span>{st.lastIsMin ? "Precio mínimo histórico detectado" : `Buen precio (ahorras ${fmtEur(st.max! - st.last!.price)})`}</span>
                </div>
              </div>

              {snaps.length >= 2 && (
                <div style="margin-bottom: 0.85rem;">
                  <Sparkline
                    values={snaps.map((s) => s.price)}
                    label={`Evolución de ${p.title}`}
                  />
                </div>
              )}

              <div>
                <AmazonLink asin={p.asin} query={p.amazonQuery} class="stitch-btn-buy">
                  <span>Ver en Amazon.es</span>
                  <Icon name="arrow-up-right" size={15} />
                </AmazonLink>
                <a href={u(`p/${p.id}/`)} class="stitch-btn-analysis">
                  <span>Ver gráfica histórica ({st.count} registros)</span>
                  <Icon name="arrow-right" size={13} style="margin-left: 0.25rem;" />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </main>
  </div>

  <!-- Spotlight Banner (Chollo de la semana) -->
  <section class="stitch-spotlight" aria-label="Chollo Destacado">
    <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: space-between; width: 100%;">
      <div style="max-width: 32rem;">
        <span class="stitch-discount-badge historic" style="margin-bottom: 0.5rem; display: inline-block;">DESTACADO DE LA SEMANA</span>
        <h3 style="font-family: Outfit, sans-serif; font-size: 1.4rem; font-weight: 800; color: var(--ink); margin: 0 0 0.45rem;">
          Logitech MX Master 3S en Mínimo Registrado
        </h3>
        <p style="font-size: 1rem; color: var(--muted); line-height: 1.55; margin: 0 0 1rem;">
          El ratón de productividad de referencia para programadores y diseñadores ha tocado su cotización más baja en Amazon.es. Silencioso, rueda MagSpeed electromagnética y batería de hasta 70 días.
        </p>
        <AmazonLink asin="B07W4DGBMC" query="logitech mx master 3s" class="stitch-btn-buy" style="width: auto; padding: 0.85rem 1.75rem; background: var(--amber); color: #ffffff;">
          <span>Comprar en Amazon.es</span>
          <Icon name="arrow-right" size={16} />
        </AmazonLink>
      </div>
      <div style="max-width: 220px; width: 100%;">
        <ProductImage asin="B07W4DGBMC" title="Logitech MX Master 3S" size="lg" />
      </div>
    </div>
  </section>

  <!-- Catálogo General / Tendencias Populares -->
  <section id="tops" aria-label="Catálogo Completo" style="margin-top: 3.5rem;">
    <div class="feed-header">
      <div>
        <h2 class="feed-title">
          <Icon name="layers" size={22} style="color: var(--accent);" />
          <span>Tendencias y Todos los Productos Recomendados</span>
        </h2>
        <p class="feed-subtitle">Catálogo curado con análisis de precios y enlaces directos de compra.</p>
      </div>
    </div>

    <div class="products-feed-grid" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
      {allProductsWithStats.map(({ p, st }) => (
        <article class="stitch-card">
          <div>
            <div class="stitch-card-top">
              <span class="stitch-cat-label">{categoryLabel[p.category]}</span>
              {p.badge && <span class="stitch-discount-badge">{p.badge}</span>}
            </div>

            {p.asin && (
              <a href={u(`p/${p.id}/`)} style="text-decoration: none; display: block;">
                <ProductImage asin={p.asin} title={p.title} size="md" />
              </a>
            )}

            <h3 class="stitch-card-title">
              <a href={u(`p/${p.id}/`)}>{p.title}</a>
            </h3>

            <p class="stitch-card-desc">{p.notes}</p>
          </div>

          <div>
            <div class="stitch-price-box">
              <div class="stitch-price-row">
                <span class="stitch-price-now">{st.count > 0 ? fmtEur(st.last!.price) : "—"}</span>
                {st.count >= 2 && (
                  <span class="stitch-price-was">{fmtEur(st.max!)}</span>
                )}
              </div>
              <div class="stitch-price-beacon">
                <span class="beacon-dot"></span>
                <span>{st.lastSeenLabel}</span>
              </div>
            </div>

            <div>
              <AmazonLink asin={p.asin} query={p.amazonQuery} class="stitch-btn-buy">
                <span>Ver en Amazon.es</span>
                <Icon name="arrow-up-right" size={15} />
              </AmazonLink>
              <a href={u(`p/${p.id}/`)} class="stitch-btn-analysis">
                <span>Analizar gráfica e histórico</span>
                <Icon name="arrow-right" size={13} style="margin-left: 0.25rem;" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Franja de Confianza y Transparencia -->
  <section class="trust-grid" aria-label="Transparencia de Datos">
    <div class="trust-card">
      <div class="trust-icon" aria-hidden="true">
        <Icon name="calendar" size={20} />
      </div>
      <h3 class="trust-title">Datos Reales y Fechados</h3>
      <p class="trust-desc">No inventamos descuentos ni reseñas. Cada precio registrado proviene de un snapshot temporal con fecha y ASIN comprobado.</p>
    </div>
    <div class="trust-card">
      <div class="trust-icon" aria-hidden="true">
        <Icon name="badge-percent" size={20} />
      </div>
      <h3 class="trust-title">Alertas de Mínimos Reales</h3>
      <p class="trust-desc">Calculamos cuándo un producto está verdaderamente barato frente a su historial para que compres en el mejor momento.</p>
    </div>
    <div class="trust-card">
      <div class="trust-icon" aria-hidden="true">
        <Icon name="shield-check" size={20} />
      </div>
      <h3 class="trust-title">Compra Directa y Transparente</h3>
      <p class="trust-desc">Enlaces directos a Amazon.es bajo el Programa de Afiliados oficial, sin sobrecostes ni suscripciones para ti.</p>
    </div>
  </section>

  <!-- Script interactivo de filtrado y búsqueda rápida -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById("product-search");
      const searchBtn = document.getElementById("search-action-btn");
      const catBtns = document.querySelectorAll(".category-filter-btn");
      const tagChips = document.querySelectorAll(".quick-tag-chip");
      const cards = document.querySelectorAll("#main-products-grid .stitch-card");

      let currentCat = "all";
      let searchQuery = "";

      function filterCards() {
        cards.forEach((card) => {
          const cardCat = card.getAttribute("data-category") || "";
          const cardTitle = card.getAttribute("data-title") || "";

          const matchesCat = currentCat === "all" || cardCat === currentCat;
          const matchesSearch = searchQuery === "" || cardTitle.includes(searchQuery);

          if (matchesCat && matchesSearch) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      }

      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = (e.target.value || "").trim().toLowerCase();
          filterCards();
        });
      }

      if (searchBtn && searchInput) {
        searchBtn.addEventListener("click", () => {
          searchQuery = (searchInput.value || "").trim().toLowerCase();
          filterCards();
        });
      }

      tagChips.forEach((chip) => {
        chip.addEventListener("click", () => {
          const term = chip.getAttribute("data-term") || "";
          if (searchInput) {
            searchInput.value = term;
            searchQuery = term.toLowerCase();
            filterCards();
          }
        });
      });

      catBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          catBtns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          currentCat = btn.getAttribute("data-cat") || "all";
          filterCards();
        });
      });
    })();
  </script>
</Base>
