---
import Base from "../layouts/Base.astro";
import AmazonLink from "../components/AmazonLink.astro";
import Sparkline from "../components/Sparkline.astro";
import { products, priceStats, fmtEur, categoryLabel, sortedSnapshots } from "../lib/catalog";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + "/";
const u = (p: string) => base + p.replace(/^\//, "");

// Precalcular estadísticas de todos los productos
const allProductsWithStats = products.map((p) => {
  const st = priceStats(p.id);
  const snaps = sortedSnapshots(p.id);
  return { p, st, snaps };
});

// Chollos y bajadas de precio
const deals = [...allProductsWithStats]
  .filter(({ st }) => st.count > 0 && (st.lastIsMin || st.discountPercent > 0))
  .sort((a, b) => b.st.discountPercent - a.st.discountPercent);

const totalTracked = products.length;
const totalDeals = deals.length;
---

<Base
  title="ORZA — Inteligencia de Precios, Chollos y Tops en Amazon.es"
  description="Rastreador inteligente de precios en Amazon.es. Históricos reales, alertas de mínimos comprobados, cálculo de ahorro y compras directas."
>
  <!-- Hero Tracker -->
  <section class="hero-tracker" aria-label="Monitor e Inteligencia de Precios">
    <h1 class="hero-title">Seguimiento de precios e inteligencia de compra en Amazon.es</h1>
    <p class="hero-desc">
      Compara la cotización actual con su histórico verificado. Detectamos mínimos reales y caídas de precio para comprar con criterio técnico.
    </p>

    <!-- Command Bar de Búsqueda -->
    <div class="search-box" role="search">
      <div class="search-input-wrap">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="product-search"
          class="search-input"
          placeholder="Buscar por producto, marca o categoría (MX Master, Epomaker, ANC)..."
          aria-label="Buscar en el catálogo de productos"
        />
        <kbd class="search-kbd" title="Presiona / para enfocar">/</kbd>
      </div>
      <button type="button" id="search-action-btn" class="search-btn">
        <span>Filtrar</span>
      </button>
    </div>

    <!-- Barra de estado discreta -->
    <div class="telemetry-chips">
      <span class="telemetry-chip">
        <strong>{totalTracked}</strong> referencias activas
      </span>
      <span class="telemetry-chip">
        <strong>{totalDeals}</strong> bajadas detectadas
      </span>
      <span class="telemetry-chip">
        Histórico con fechas reales
      </span>
    </div>
  </section>

  <!-- Sección Chollos y Bajadas de Precio -->
  <section id="chollos" aria-label="Chollos y Mínimos">
    <div class="section-header">
      <h2>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--emerald)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline>
          <polyline points="17 18 23 18 23 12"></polyline>
        </svg>
        <span>Chollos y Mínimos Registrados</span>
      </h2>
      <a class="section-link" href={u("registro/")}>Ver registro completo →</a>
    </div>

    <div class="products-grid" id="deals-grid">
      {deals.map(({ p, st, snaps }) => (
        <article class="product-card" data-category={p.category} data-title={p.title.toLowerCase()}>
          <div class="product-card-top">
            <span class="product-cat">{categoryLabel[p.category]}</span>
            <span class={`deal-badge ${st.lastIsMin ? "historic" : ""}`}>
              {st.lastIsMin ? "MÍNIMO HISTÓRICO" : `-${st.discountPercent}% DESCUENTO`}
            </span>
          </div>

          <h3 class="product-title">
            <a href={u(`p/${p.id}/`)}>{p.title}</a>
          </h3>

          <p class="product-desc">{p.notes}</p>

          <div class="price-block">
            <div class="price-row">
              <span class="price-current">{fmtEur(st.last!.price)}</span>
              {st.max && st.max > st.last!.price && (
                <span class="price-prev">{fmtEur(st.max)}</span>
              )}
            </div>
            <div class="price-meta">
              <span>{st.lastSeenLabel}</span>
              {st.max && st.max > st.last!.price && (
                <span style="color: var(--emerald); font-weight: 700;">
                  Ahorro: {fmtEur(st.max - st.last!.price)}
                </span>
              )}
            </div>
          </div>

          {snaps.length >= 2 && (
            <div style="margin-bottom: 0.85rem;">
              <Sparkline
                values={snaps.map((s) => s.price)}
                label={`Evolución de ${p.title}: mín ${fmtEur(st.min!)}, máx ${fmtEur(st.max!)}`}
              />
            </div>
          )}

          <div class="product-actions">
            <AmazonLink asin={p.asin} query={p.amazonQuery} class="btn-buy">
              <span>Ver en Amazon.es</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </AmazonLink>
            <a href={u(`p/${p.id}/`)} class="btn-details">
              Análisis completo ({st.count} registros)
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Spotlight / Banner de Monetización & Recomendación -->
  <section class="ad-spotlight" aria-label="Recomendación Destacada">
    <div class="ad-spotlight-content">
      <h3 class="ad-spotlight-title">Logitech MX Master 3S en Mínimo Registrado</h3>
      <p class="ad-spotlight-text">
        El ratón de productividad de referencia para desarrolladores y diseñadores ha alcanzado su cotización más baja en Amazon.es.
      </p>
    </div>
    <AmazonLink asin="B07W4DGBMC" query="logitech mx master 3s" class="btn">
      <span>Ver cotización en Amazon.es →</span>
    </AmazonLink>
  </section>

  <!-- Sección Tops & Catálogo por Categoría -->
  <section id="tops" aria-label="Top Productos Monitoreados">
    <div class="section-header">
      <h2>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>Productos Monitoreados</span>
      </h2>
    </div>

    <!-- Pestañas de categoría -->
    <div class="category-filter" role="tablist" aria-label="Filtrar por categoría">
      <button type="button" class="cat-btn active" data-cat="all">Todos ({totalTracked})</button>
      <button type="button" class="cat-btn" data-cat="teclados">Teclados</button>
      <button type="button" class="cat-btn" data-cat="perifericos">Periféricos & Setup</button>
      <button type="button" class="cat-btn" data-cat="audio">Audio & Auriculares</button>
      <button type="button" class="cat-btn" data-cat="descanso">Descanso & Salud</button>
    </div>

    <div class="products-grid" id="catalog-grid">
      {allProductsWithStats.map(({ p, st }) => (
        <article class="product-card" data-category={p.category} data-title={p.title.toLowerCase()}>
          <div class="product-card-top">
            <span class="product-cat">{categoryLabel[p.category]}</span>
            {p.badge && <span class="deal-badge">{p.badge}</span>}
          </div>

          <h3 class="product-title">
            <a href={u(`p/${p.id}/`)}>{p.title}</a>
          </h3>

          <p class="product-desc">{p.notes}</p>

          <div class="price-block">
            <div class="price-row">
              <span class="price-current">{st.count > 0 ? fmtEur(st.last!.price) : "—"}</span>
              {st.count >= 2 && (
                <span class="price-prev">{fmtEur(st.max!)}</span>
              )}
            </div>
            <div class="price-meta">
              <span>{st.lastSeenLabel}</span>
              {st.count >= 2 && (
                <span>Rango: {fmtEur(st.min!)} – {fmtEur(st.max!)}</span>
              )}
            </div>
          </div>

          <div class="product-actions">
            <AmazonLink asin={p.asin} query={p.amazonQuery} class="btn-buy">
              <span>Ver en Amazon.es</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </AmazonLink>
            <a href={u(`p/${p.id}/`)} class="btn-details">
              Analizar precio y gráfica
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Buscador Rápido de Categorías en Amazon -->
  <section id="buscador" aria-label="Búsqueda Directa en Amazon.es" style="margin-top: 3.5rem;">
    <div class="section-header">
      <h2>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <circle cx="12" cy="12" r="6"></circle>
          <circle cx="12" cy="12" r="2"></circle>
        </svg>
        <span>Accesos Directos a Amazon.es</span>
      </h2>
    </div>
    <div class="products-grid">
      <div class="product-card" style="justify-content: center; gap: 0.75rem;">
        <span class="product-cat">Categoría</span>
        <h3 class="product-title" style="margin: 0;">Teclados Mecánicos Hot-Swap</h3>
        <p class="product-desc">Switches mecánicos, formatos 60%, 75% y TKL.</p>
        <AmazonLink query="teclados mecanicos hot swap espana" class="btn-buy">
          <span>Explorar Teclados en Amazon →</span>
        </AmazonLink>
      </div>
      <div class="product-card" style="justify-content: center; gap: 0.75rem;">
        <span class="product-cat">Categoría</span>
        <h3 class="product-title" style="margin: 0;">Auriculares con Cancelación Activa</h3>
        <p class="product-desc">Modelos inalámbricos con ANC para trabajo y viajes.</p>
        <AmazonLink query="auriculares cancelacion ruido anc" class="btn-buy">
          <span>Explorar Auriculares en Amazon →</span>
        </AmazonLink>
      </div>
      <div class="product-card" style="justify-content: center; gap: 0.75rem;">
        <span class="product-cat">Categoría</span>
        <h3 class="product-title" style="margin: 0;">Ergonomía & Setup</h3>
        <p class="product-desc">Brazos para monitor, ratones verticales y alfombrillas deskmat.</p>
        <AmazonLink query="ergonomia setup escritorio brazo monitor" class="btn-buy">
          <span>Explorar Ergonomía en Amazon →</span>
        </AmazonLink>
      </div>
      <div class="product-card" style="justify-content: center; gap: 0.75rem;">
        <span class="product-cat">Categoría</span>
        <h3 class="product-title" style="margin: 0;">Descanso & Aislamiento</h3>
        <p class="product-desc">Tapones de reducción de ruido y antifaces opacos 3D.</p>
        <AmazonLink query="tapones oido dormir antifaz 3d" class="btn-buy">
          <span>Explorar Descanso en Amazon →</span>
        </AmazonLink>
      </div>
    </div>
  </section>

  <!-- Script interactivo de filtrado y búsqueda client-side -->
  <script is:inline>
    (function () {
      const searchInput = document.getElementById("product-search");
      const searchBtn = document.getElementById("search-action-btn");
      const catBtns = document.querySelectorAll(".cat-btn");
      const cards = document.querySelectorAll("#catalog-grid .product-card, #deals-grid .product-card");

      let currentCat = "all";
      let searchQuery = "";

      function filterCards() {
        cards.forEach((card) => {
          const cardCat = card.getAttribute("data-category") || "";
          const cardTitle = card.getAttribute("data-title") || "";

          const matchesCat = currentCat === "all" || cardCat === currentCat;
          const matchesSearch = searchQuery === "" || cardTitle.includes(searchQuery);

          if (matchesCat && matchesSearch) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      }

      if (searchInput) {
        searchInput.addEventListener("input", (e) => {
          searchQuery = (e.target.value || "").trim().toLowerCase();
          filterCards();
        });

        // Atajo de teclado "/"
        window.addEventListener("keydown", (e) => {
          if (e.key === "/" && document.activeElement !== searchInput) {
            e.preventDefault();
            searchInput.focus();
          }
        });
      }

      if (searchBtn && searchInput) {
        searchBtn.addEventListener("click", () => {
          const val = searchInput.value.trim();
          if (val) {
            location.href = "#tops";
          }
        });
      }

      catBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          catBtns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          currentCat = btn.getAttribute("data-cat") || "all";
          filterCards();
        });
      });
    })();
  </script>
</Base>
